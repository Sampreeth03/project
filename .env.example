# Backend core
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/page-check?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:5000

# Login OTP behavior
# Keep true in production unless you explicitly want password-only login.
LOGIN_OTP_REQUIRED=true
# Comma-separated emails that can skip email OTP (still subject to authenticator challenge if enabled).
LOGIN_OTP_BYPASS_EMAILS=srihesh@gm.co,priya@gm.co,shiva@gm.co,arjun@gm.co

# Redis cache
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Cache TTL tuning (seconds)
CACHE_TTL_DEFAULT=900
CACHE_TTL_DASHBOARD=45
CACHE_TTL_USER_DASHBOARD=45
CACHE_TTL_USER_PROFILE=1800
CACHE_TTL_FRIENDS=20
CACHE_TTL_PROJECTS=600
CACHE_TTL_RECRUITER=45
CACHE_TTL_ADMIN=60
CACHE_TTL_MESSAGE=20
CACHE_TTL_JOB=30
CACHE_TTL_DOUBT=20
CACHE_TTL_PUBLIC=20
CACHE_TTL_NOTIFICATIONS=20

# Solr search
SOLR_BASE_URL=http://localhost:8983/solr
SOLR_TIMEOUT_MS=10000
SOLR_SYNC_ENABLED=true
SOLR_COLLECTION_USERS=users
SOLR_COLLECTION_PROJECTS=projects
SOLR_COLLECTION_JOBS=jobs
SOLR_BIN=
SOLR_HOME=
SOLR_REQUIRE_CLOUD=true
SOLR_CONFIGSET=_default
SOLR_START_WAIT_ATTEMPTS=60
SOLR_START_WAIT_DELAY_MS=1000
SEARCH_JOBS_FILTER_SCAN_LIMIT=2000

# Email / OTP
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=RELABTeams
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
MOCK_PAYMENTS=true

# Benchmark script vars
BENCH_BASE_URL=http://localhost:5000/api
BENCH_ENDPOINT=/dashboard-trends
BENCH_EMAIL=
BENCH_PASSWORD=
BENCH_COOKIE=
BENCH_REQUESTS=100
BENCH_CONCURRENCY=10

# Frontend (set in your frontend host env)
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
