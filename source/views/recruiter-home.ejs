<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RELABTeams</title>
    <style>
        /* Dark Theme CSS */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #121212;
    color: white;
}

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    background-color: black;
    padding: 15px 5%;
    display: flex;
    z-index: 1000;
    align-items: center;
    justify-content: flex-start;
    box-sizing: border-box;
}

.logo {
    font-size: 30px;
    color: #0068FF;
    font-weight: bold;
    margin-right: 30px;
    flex-shrink: 0;
}

#logo-link {
    text-decoration: none;
    color: #0068FF;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 38px;
    position: relative;
    margin: 0;
    padding: 0;
    flex: 1;
}

.nav-links li {
    position: relative;
}

.nav-links li a {
    color: white;
    text-decoration: none;
    font-size: 20px;
    transition: color 0.3s ease;
    padding: 10px;
    display: block;
}

.nav-links li a:hover {
    color: #0068FF;
}

.dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: black;
    min-width: max-content;
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
    z-index: 1000;
}

.dropdown li {
    width: 100%;
}

.dropdown li a {
    padding: 12px;
    font-size: 18px;
    display: block;
    color: white;
    white-space: nowrap;
}

.dropdown li a:hover {
    background-color: #333;
    color: #0068FF;
}

.nav-links li:hover .dropdown {
    display: block;
}

.search-box {
    padding: 8px;
    border-radius: 5px;
    border: none;
    outline: none;
    width: 205px;
    background-color: #222;
    color: white;
}

.logout-container {
        position: fixed;
        top: 60px; /* Matches navbar height */
        right: 5%; /* Aligns with navbar padding */
        z-index: 900; /* Below navbar but above content */
        width: auto;
    }

    .logout-btn {
  background-color: #ff0000;
  color: white;
  border: none;
  padding: 10px 20px;
  font-size: 16px;
  cursor: pointer;
  border-radius: 5px;
  transition: background-color 0.3s ease;
  text-decoration: none;
}
.logout-btn:hover {
  background-color: #cc0000;
}


/* Main content */
.hero {
    padding: 50px 30px;
    text-align: center;
    background-color: #1e1e1e;
    font-size: 25px;
    border-bottom: 1px solid #333;
    margin-top: 60px; /* Added to ensure content appears below navbar */
}

.hero h1 span {
    color: #0068FF;
}

/* Fixed Button with Sliding Effect */
.btn {
    background-color: black;
    color: white;
    border: 2px solid #0068FF;
    padding: 10px 20px;
    margin-top: 20px;
    cursor: pointer;
    height: 60px;
    width: 200px;
    font-size: 20px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: color 0.3s ease;
}

.btn::before {
    content: "";
    position: absolute;
    background-color: #0068FF;
    width: 100%;
    height: 100%;
    left: 0;
    bottom: -100%;
    transition: bottom 0.3s ease;
    z-index: -1;
}

.btn:hover {
    color: white;
}

.btn:hover::before {
    bottom: 0;
}

#options-button {
    position: relative;
    z-index: 2;
}

/* Options Container */
.options-container {
    display: none;
    margin-top: 20px;
    text-align: center;
}

.option-btn {
    background-color: black;
    color: white;
    border: 1px solid #0068FF;
    padding: 15px 30px;
    margin: 10px;
    cursor: pointer;
    font-size: 16px;
    transition: background-color 0.3s ease;
}

.option-btn:hover {
    background-color: #0068FF;
}

/* Features */
.features {
    padding: 50px 30px;
    background-color: #121212;
    text-align: center;
}

.features h2 {
    color: #0068FF;
    margin-bottom: 30px;
}

.feature-box {
    display: inline-block;
    width: 30%;
    height: 200px; /* Fixed height for all feature boxes */
    margin: 10px;
    padding: 25px 15px;
    background-color: #1e1e1e;
    vertical-align: top;
    border-radius: 5px;
    border: 1px solid #333;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-sizing: border-box; /* Ensures padding is included in width/height */
    overflow: auto; /* In case content is too long */
}

.feature-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 104, 255, 0.2);
}

.feature-box h3 {
    color: #0068FF;
    margin-top: 0; /* Ensures consistent spacing */
}

/* Mobile */
.menu-btn {
    display: none;
    float: right;
    background: none;
    border: none;
    color: white;
    font-size: 20px;
    cursor: pointer;
    padding-top: 25px;
    padding-right: 15px;
}

/* Responsive */
@media screen and (max-width: 700px) {
    .nav-links {
        display: none;
    }
    
.logout-btn {
            padding: 8px 15px;
            font-size: 14px;
          }
    .menu-btn {
        display: block;
    }
    
    .nav-links.show {
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background-color: black;
        display: block;
        text-align: center;
        padding: 0;
        z-index: 100;
        border-bottom: 1px solid #0068FF;
    }
    
    .nav-links.show a {
        display: block;
        padding: 15px;
        margin: 0;
        border-bottom: 1px solid #333;
    }
    
    .feature-box {
        width: 90%;
        height: auto; /* Allow height to adjust on mobile */
        min-height: 150px; /* Minimum height on mobile */
    }
    
    .option-btn {
        display: block;
        width: 80%;
        margin: 10px auto;
    }
}
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <div class="logo">
                <a id="logo-link" href="<%= homeUrl %>">RELABTeams</a>
            </div>
            <ul class="nav-links">
                <% navLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>"><%= link.name %></a>
                        <% if (link.submenu) { %>
                            <ul class="dropdown">
                                <% link.submenu.forEach(sublink => { %>
                                    <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        </div>
    </header>
    <div class="logout-container">
        <button class="logout-btn"><a href="/logout" style="text-decoration: none; color: white;">Logout</a></button>
    </div>

    <div class="hero">
        <h1>Find the <span>Perfect Talent</span> for Your Team</h1>
        <p>RELABTeams helps you discover, connect, and hire the best professionals for your company.</p>
        <button class="btn" id="recruitButton"><span id="options-button">Start Recruiting</span></button>
        
        <div class="options-container" id="options">
            <button class="option-btn"><a href="/rec-app" style="text-decoration: none;color:white;">Applications</a></button>
            <button class="option-btn"><a href="/rec-job" style="text-decoration: none;color:white;">Create Jobs</a></button>
        </div>
    </div>

    <div class="features">
        <h2>Why Choose RELABTeams</h2>
        <div class="feature-box">
            <h3>Smart Hiring</h3>
            <p>Our users apply for your posts and you can hire them based on your interest.</p>
        </div>
        <div class="feature-box">
            <h3>View Profiles</h3>
            <p>View users profiles who applied for your post</p>
        </div>
        <div class="feature-box">
            <h3>This or That!!</h3>
            <p>You can either ask other users to finish your project or hire them.</p>
        </div>
    </div>

    <script>
        // Get elements
        var menuButton = document.getElementById("menuButton");
        var navMenu = document.getElementById("navMenu");
        var recruitButton = document.getElementById("recruitButton");
        var options = document.getElementById("options");
        
        // Mobile menu button click
        if (menuButton) {
            menuButton.onclick = function() {
                if (navMenu.className === "nav-links") {
                    navMenu.className = "nav-links show";
                } else {
                    navMenu.className = "nav-links";
                }
            };
        }
        
        // Recruit button click
        recruitButton.onclick = function() {
            if (options.style.display === "block") {
                options.style.display = "none";
            } else {
                options.style.display = "block";
            }
        };
    </script>
</body>
</html>