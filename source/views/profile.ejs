
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Profile Page</title>
    <style>
        .navbar { position: fixed; top: 0; left: 0; width: 100%; height: 45px; background-color: black; padding: 15px 5%; display: flex; z-index: 1000; align-items: center; justify-content: space-between; }
        .logo { font-size: 30px; color: #0068FF; font-weight: bold; margin-right: 30px; }
        #logo-link { text-decoration: none; color: #0068FF; }
        .nav-links { list-style: none; display: flex; gap: 38px; position: relative; margin:0; padding:0; }
        .nav-links li { position: relative; }
        .nav-links li a { color: white; text-decoration: none; font-size: 20px; transition: color 0.3s ease; padding: 10px; display: block; }
        .nav-links li a:hover { color: #0068FF; }
        .dropdown { display: none; position: absolute; top: 100%; left: 0; background-color: black; min-width: max-content; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2); z-index: 1000; }
        .dropdown li { width: 100%; }
        .dropdown li a { padding: 12px; font-size: 18px; display: block; color: white; white-space: nowrap; }
        .dropdown li a:hover { background-color: #333; color: #0068FF; }
        .nav-links li:hover .dropdown { display: block; }
        .search-box { padding: 8px; border-radius: 5px; border: none; outline: none; width: 205px; background-color: #222; color: white; }
        body {
            font-family: Arial, sans-serif;
            background-color: #000;
            margin: 0;
            padding: 0;
            margin-top: 75px;
            color: #fff;
        }
        .profile-container {
            background: rgb(45,45,45);
            padding: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            text-align: center;
            width: 1150px;
            max-width: calc(100% - 40px);
            margin: 0 auto 60px;
            position: relative;
        }
        .profile-header { display: flex; align-items: center; gap: 20px; justify-content: center; flex-wrap:wrap; }
        .profile-pic {
            width: 200px; height: 200px; border-radius: 50%; border: 2px solid #0068FF; overflow: hidden; position: relative; display:flex; justify-content:center; align-items:center; background:#222;
        }
        .profile-pic img { width:100%; height:100%; object-fit:cover; display:none; }
        .profile-pic .plusButton { display:flex; justify-content:center; align-items:center; position:absolute; }
        .profile-info { display:flex; flex-direction:column; justify-content:center; align-items:center; }
        .profile-info h2 { margin: 10px 0; color:#fff; font-size:36px; }
        .profile-info p { color:#ddd; font-size:18px; margin:5px 0; }
        .details-container { text-align:left; margin-top:20px; }
        .details-container h3 { color:#fff; margin-bottom:8px; font-size:24px; }
        .skills, .interests { display:flex; flex-wrap:wrap; gap:8px; }
        .skill, .interest { background:#0068FF; color:white; padding:6px 10px; border-radius:5px; font-size:16px; }
        .resume-container { margin-top:20px; position:relative; }
        .resume-container iframe { width:100%; height:280px; border:1px solid #333; margin-top:10px; background:#fff; }
        .edit-button { width:40px; height:40px; border-radius:50%; background-color:rgb(20,20,20); border:none; display:flex; align-items:center; justify-content:center; box-shadow:0 0 20px rgba(0,0,0,0.16); cursor:pointer; position:absolute; top:10px; right:10px; }
        .edit-svgIcon { width:17px; }
        .edit-svgIcon path { fill:white; }
        .edit-mode { position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:10; display:none; justify-content:center; align-items:center; }
        .edit-mode.active { display:flex; }
        .edit-mode-content { background:white; color:#000; padding:30px; border-radius:8px; width:520px; max-height:90%; overflow:auto; box-shadow:0 6px 24px rgba(0,0,0,0.4); }
        .edit-mode label { display:block; margin-bottom:6px; font-weight:bold; }
        .edit-mode input, .edit-mode textarea { width:100%; padding:8px; margin-bottom:12px; border:1px solid #ccc; border-radius:4px; font-size:14px; box-sizing:border-box; }
        .but-cont { display:flex; gap:10px; justify-content:center; }
        .but-cont button { padding:8px 16px; border-radius:4px; border:none; cursor:pointer; }
        .btn-save { background:#0068FF; color:#fff; }
        .btn-cancel { background:#444; color:#fff; }
        .feedback { color:#fff; font-size:18px; margin-top:10px; display:flex; gap:18px; justify-content:center; align-items:center; flex-wrap:wrap; }
        hr { border-color:#333; margin:18px 0; }
        ul { list-style:none; padding:0; margin:0; }
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <span class="logo"><a id="logo-link" href="<%= homeUrl || '/' %>">RELABTeams</a></span>
            <ul class="nav-links">
                <% (navLinks || []).forEach(function(link){ %>
                    <li>
                        <a href="<%= link.href %>"><%= link.name %></a>
                        <% if (link.submenu && link.submenu.length){ %>
                            <ul class="dropdown">
                                <% link.submenu.forEach(function(s){ %>
                                    <li><a href="<%= s.href %>"><%= s.name %></a></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
            <input class="search-box" placeholder="Search" />
        </div>
    </header>

    <div class="profile-container">
        <button class="edit-button" onclick="toggleEditMode()" title="Edit profile">
            <svg class="edit-svgIcon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                <path d="M410.3 231l11.3-11.3-33.9-33.9-62.1-62.1L291.7 89.8l-11.3 11.3-22.6 22.6L58.6 322.9c-10.4 10.4-18 23.3-22.2 37.4L1 480.7c-2.5 8.4-.2 17.5 6.1 23.7s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L387.7 253.7 410.3 231zM160 399.4l-9.1 22.7c-4 3.1-8.5 5.4-13.3 6.9L59.4 452l23-78.1c1.4-4.9 3.8-9.4 6.9-13.3l22.7-9.1v32c0 8.8 7.2 16 16 16h32zM362.7 18.7L348.3 33.2 325.7 55.8 314.3 67.1l33.9 33.9 62.1 62.1 33.9 33.9 11.3-11.3 22.6-22.6 14.5-14.5c25-25 25-65.5 0-90.5L453.3 18.7c-25-25-65.5-25-90.5 0zm-47.4 168l-144 144c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l144-144c6.2-6.2 16.4-6.2 22.6 0s6.2 16.4 0 22.6z"/>
            </svg>
        </button>

        <div class="profile-header">
            <div class="profile-pic" id="profilePic" style="<%= user && user.profileImageUrl ? 'background-color:transparent;' : '' %>">
                <img id="profileImage" src="<%= user && user.profileImageUrl ? user.profileImageUrl : '' %>" alt="Profile Picture" style="<%= user && user.profileImageUrl ? 'display:block;' : 'display:none;' %>" />
                <% if (!(user && user.profileImageUrl)) { %>
                    <div tabindex="0" class="plusButton" onclick="document.getElementById('directProfilePic').click()">
                        <svg class="plusIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30">
                            <path d="M13.75 23.75V16.25H6.25V13.75H13.75V6.25H16.25V13.75H23.75V16.25H16.25V23.75H13.75Z"></path>
                        </svg>
                    </div>
                <% } %>
                <input id="directProfilePic" type="file" accept="image/*" style="display:none" onchange="loadImage(event)" />
            </div>

            <div class="profile-info">
                <h2 id="displayName"><%= (user && user.name) ? user.name : 'Your name' %></h2>
                <p id="displayEmail">Email: <%= (user && user.email) ? user.email : '' %></p>
                <div class="feedback">
                    <span>Questions Answered: <strong id="questionsAnswered"><%= (user && user.questionsAnswered) ? user.questionsAnswered : 0 %></strong></span>
                </div>
            </div>
        </div>

        <hr />

        <div class="profile-details">
            <div class="details-container">
                <h3>About Me:</h3>
                <p id="displayAbout" style="font-size:18px; color: #c3bfbf;"><%= (user && user.about) ? user.about : '' %></p>
            </div>

            <div class="details-container">
                <h3>Skills:</h3>
                <div class="skills" id="skillsContainer">
                    <% if (user && Array.isArray(user.skills) && user.skills.length) { %>
                        <% user.skills.forEach(function(s){ %>
                            <span class="skill"><%= s %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <div class="details-container">
                <h3>Interested In:</h3>
                <div class="interests" id="interestsContainer">
                    <% if (user && Array.isArray(user.interests) && user.interests.length) { %>
                        <% user.interests.forEach(function(i){ %>
                            <span class="interest"><%= i %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <hr />
            <h3 style="color:#fff; font-size:24px;">Resume:</h3>
            <div class="resume-container">
                <button id="addResumeBtn" onclick="document.getElementById('directResume').click()" style="<%= (user && user.resumeUrl) ? 'display:none;' : '' %>">
                    <span class="text">Add</span>
                    <span class="buttonSpan">+</span>
                </button>
                <iframe id="resumeFrame" src="<%= (user && user.resumeUrl) ? user.resumeUrl : '' %>"></iframe>
                <input id="directResume" type="file" accept=".pdf" style="display:none" onchange="loadResume(event)" />
            </div>
        </div>

        <!-- edit form modal -->
        <div class="edit-mode" id="editMode">
            <div class="edit-mode-content">
                <form id="editForm" onsubmit="event.preventDefault(); saveChanges();">
                    <label for="editName">Name:</label>
                    <input id="editName" name="name" type="text" placeholder="Name" />

                    <label for="editEmail">Email:</label>
                    <input id="editEmail" name="email" type="email" placeholder="Email" />

                    <label for="editAbout">About Me:</label>
                    <textarea id="editAbout" name="about" placeholder="About Me" rows="4"></textarea>

                    <label for="editSkills">Skills (comma separated):</label>
                    <input id="editSkills" name="skills" type="text" placeholder="JavaScript, Node.js" />

                    <label for="editInterests">Interests (comma separated):</label>
                    <input id="editInterests" name="interests" type="text" placeholder="Blockchain, AI" />

                    <label for="editProfilePic">Profile Picture:</label>
                    <input id="editProfilePic" name="profilePic" type="file" accept="image/*" />

                    <label for="editResume">Resume (PDF):</label>
                    <input id="editResume" name="resume" type="file" accept=".pdf" />

                    <div class="but-cont">
                        <button type="button" class="btn-save" onclick="saveChanges()">Save</button>
                        <button type="button" class="btn-cancel" onclick="cancelEdit()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // wrap to ensure elements exist
        document.addEventListener('DOMContentLoaded', function(){
            // load preview when user picks a profile image (shared by both direct and edit inputs)
            window.loadImage = function(event) {
                const profileImage = document.getElementById("profileImage");
                const profilePic = document.getElementById("profilePic");
                const file = event.target.files && event.target.files[0];
                if (file && profileImage) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        profileImage.src = e.target.result;
                        profileImage.style.display = "block";
                        if (profilePic) profilePic.style.backgroundColor = "transparent";
                        const plus = document.querySelector('.plusButton');
                        if (plus) plus.style.display = 'none';
                    };
                    reader.readAsDataURL(file);
                }
            };

            // load resume preview
            window.loadResume = function(event) {
                const resumeFrame = document.getElementById("resumeFrame");
                const file = event.target.files && event.target.files[0];
                if (file && resumeFrame) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        resumeFrame.src = e.target.result;
                        const addBtn = document.getElementById('addResumeBtn');
                        if (addBtn) addBtn.style.display = 'none';
                    };
                    reader.readAsDataURL(file);
                }
            };

            // open edit modal and prefill from current page (or server-provided values)
            window.toggleEditMode = function() {
                const editMode = document.getElementById("editMode");
                if (!editMode) return;
                editMode.classList.toggle("active");
                if (editMode.classList.contains("active")) {
                    document.getElementById("editName").value = document.getElementById("displayName").textContent || "";
                    const emailText = document.getElementById("displayEmail").textContent.replace(/^Email:\s*/i, "");
                    document.getElementById("editEmail").value = emailText || "";
                    document.getElementById("editAbout").value = document.getElementById("displayAbout").innerText || "";

                    const skills = Array.from(document.querySelectorAll("#skillsContainer .skill")).map(el => el.textContent);
                    document.getElementById("editSkills").value = skills.join(", ");

                    const interests = Array.from(document.querySelectorAll("#interestsContainer .interest")).map(el => el.textContent);
                    document.getElementById("editInterests").value = interests.join(", ");
                }
            };

            // save changes via multipart/form-data to server route /profile (server should accept fields and files)
            window.saveChanges = function() {
                const form = document.getElementById("editForm");
                if (!form) return;
                const formData = new FormData();

                formData.append("name", document.getElementById("editName").value || "");
                formData.append("email", document.getElementById("editEmail").value || "");
                formData.append("about", document.getElementById("editAbout").value || "");
                formData.append("skills", document.getElementById("editSkills").value || "");
                formData.append("interests", document.getElementById("editInterests").value || "");

                const profilePicFile = document.getElementById("editProfilePic").files[0];
                const resumeFile = document.getElementById("editResume").files[0];

                if (profilePicFile) formData.append("picture", profilePicFile);
                if (resumeFile) formData.append("resume", resumeFile);
                fetch('/profile', {
                    method: 'POST',
                    body: formData
                }).then(async res => {
                    if (!res.ok) throw new Error("Server returned " + res.status);
                    const contentType = res.headers.get('content-type') || '';
                    if (contentType.includes('application/json')) {
                        return res.json();
                    } else {
                        // non-json response: reload page to reflect changes
                        window.location.reload();
                        return null;
                    }
                }).then(data => {
                    if (!data) return;
                    if (data.success && data.user) {
                        const u = data.user;
                        document.getElementById("displayName").textContent = u.name || '';
                        document.getElementById("displayEmail").textContent = "Email: " + (u.email || '');
                        document.getElementById("displayAbout").innerText = u.about || '';
                        document.getElementById("questionsAnswered").textContent = u.questionsAnswered || 0;

                        const skillsContainer = document.getElementById("skillsContainer");
                        if (skillsContainer) {
                            skillsContainer.innerHTML = "";
                            (u.skills || []).forEach(s => {
                                const el = document.createElement("span");
                                el.className = "skill";
                                el.textContent = s;
                                skillsContainer.appendChild(el);
                            });
                        }

                        const interestsContainer = document.getElementById("interestsContainer");
                        if (interestsContainer) {
                            interestsContainer.innerHTML = "";
                            (u.interests || []).forEach(i => {
                                const el = document.createElement("span");
                                el.className = "interest";
                                el.textContent = i;
                                interestsContainer.appendChild(el);
                            });
                        }

                        if (u.profileImageUrl) {
                            const img = document.getElementById("profileImage");
                            img.src = u.profileImageUrl;
                            img.style.display = "block";
                            const plus = document.querySelector('.plusButton');
                            if (plus) plus.style.display = 'none';
                        }
                        if (u.resumeUrl) {
                            const frame = document.getElementById("resumeFrame");
                            frame.src = u.resumeUrl;
                            const addBtn = document.getElementById("addResumeBtn");
                            if (addBtn) addBtn.style.display = 'none';
                        }

                        document.getElementById("editMode").classList.remove("active");
                    } else {
                        alert("Failed to save profile. Check server response.");
                    }
                }).catch(err => {
                    console.error(err);
                    alert(err);
                });
            };

            window.cancelEdit = function() {
                const editMode = document.getElementById("editMode");
                if (editMode) editMode.classList.remove("active");
            };

            // wire preview inputs to preview functions (if present)
            const ePic = document.getElementById("editProfilePic");
            if (ePic) ePic.addEventListener("change", loadImage);

            const eResume = document.getElementById("editResume");
            if (eResume) eResume.addEventListener("change", loadResume);

            const dPic = document.getElementById("directProfilePic");
            if (dPic) dPic.addEventListener("change", loadImage);

            const dResume = document.getElementById("directResume");
            if (dResume) dResume.addEventListener("change", loadResume);
        });
    </script>
</body>
</html>
