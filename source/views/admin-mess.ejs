<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RELABTeams Message Monitoring</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #0068FF;
            --secondary: #0056d6;
            --dark: #121212;
            --darker: #0a0a0a;
            --light-text: #ffffff;
            --gray-text: #a0a0a0;
            --gray-dark: #2a2a2a;
            --success: #4ade80;
            --danger: #ef4444;
            --warning: #f59e0b;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: var(--dark);
            color: var(--light-text);
        }
        
        .container {
            display: flex;
            min-height: 100vh;
        }
        
        .sidebar {
            width: 280px;
            background-color: var(--darker);
            color: var(--light-text);
            padding: 20px 0;
            height: 100vh;
            position: fixed;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 100;
        }
        
        .sidebar-header {
            padding: 0 25px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }
        
        .logo {
            display: flex;
            align-items: center;
            color: var(--light-text);
            text-decoration: none;
        }
        
        .logo img {
            height: 40px;
            margin-right: 10px;
        }
        
        .logo-text {
            font-size: 22px;
            font-weight: 700;
            color: #0068FF;
        }
        
        .nav-menu {
            padding: 10px 0;
        }
        
        .menu-label {
            padding: 0 25px;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--gray-text);
            margin-bottom: 10px;
            margin-top: 20px;
        }
        
        .menu-item {
            padding: 12px 25px;
            display: flex;
            align-items: center;
            color: var(--gray-text);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }
        
        .menu-item:hover {
            color: var(--light-text);
            background-color: rgba(255, 255, 255, 0.05);
        }
        
        .menu-item.active {
            color: var(--light-text);
            background-color: rgba(0, 104, 255, 0.1);
            border-left: 4px solid var(--primary);
        }
        
        .menu-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            font-size: 18px;
        }
        
        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 30px;
            transition: all 0.3s;
            overflow-x: hidden;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .welcome h2 {
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .welcome h4 {
            color: var(--gray-text);
            font-weight: normal;
        }
        
        .admin-controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        .search-box {
            position: relative;
            width: 300px;
        }
        
        .search-box input {
            width: 100%;
            padding: 10px 40px 10px 15px;
            border-radius: 8px;
            border: 1px solid var(--gray-dark);
            background-color: var(--darker);
            color: var(--light-text);
            outline: none;
        }
        
        .search-box input::placeholder {
            color: var(--gray-text);
        }
        
        .search-box i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-text);
        }
        
        .admin-profile {
            display: flex;
            align-items: center;
            cursor: pointer;
        }
        
        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }
        
        .admin-info {
            display: flex;
            flex-direction: column;
        }
        
        .admin-name {
            font-weight: 500;
        }
        
        .admin-role {
            font-size: 12px;
            color: var(--gray-text);
        }
        
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .btn-primary {
            background-color: var(--primary);
            color: var(--light-text);
        }
        
        .btn-primary:hover {
            background-color: var(--secondary);
        }
        
        .btn-outline {
            background-color: transparent;
            color: var(--light-text);
            border: 1px solid var(--gray-dark);
        }
        
        .btn-outline:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
        
        /* Messages Monitoring Specific Styles */
        .messages-container {
            display: flex;
            height: calc(100vh - 150px);
            background-color: var(--darker);
            border-radius: 10px;
            overflow: hidden;
        }
        
        .contacts-panel {
            width: 30%;
            background-color: var(--darker);
            border-right: 1px solid var(--gray-dark);
            overflow-y: auto;
        }
        
        .contacts-header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--gray-dark);
        }
        
        .contacts-title {
            font-size: 18px;
            font-weight: 500;
        }
        
        .filter-dropdown {
            position: relative;
        }
        
        .filter-btn {
            background-color: var(--dark);
            color: var(--light-text);
            border: 1px solid var(--gray-dark);
            border-radius: 4px;
            padding: 6px 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
        }
        
        .contact-search {
            padding: 15px 20px;
            position: relative;
        }
        
        .contact-search input {
            width: 100%;
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid var(--gray-dark);
            background-color: var(--dark);
            color: var(--light-text);
            outline: none;
        }
        
        .contact-list {
            list-style: none;
        }
        
        .contact-item {
            padding: 15px 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--gray-dark);
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .contact-item:hover, .contact-item.active {
            background-color: rgba(0, 104, 255, 0.1);
        }
        
        .contact-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background-color: var(--gray-dark);
            margin-right: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: var(--light-text);
        }
        
        .contact-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .contact-info {
            flex: 1;
        }
        
        .contact-name {
            font-weight: 500;
            margin-bottom: 5px;
            display: flex;
            justify-content: space-between;
        }
        
        .contact-time {
            font-size: 12px;
            color: var(--gray-text);
        }
        
        .contact-preview {
            color: var(--gray-text);
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 180px;
        }
        
        .contact-status {
            display: flex;
            align-items: center;
        }
        
        .status-flag {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: var(--warning);
            margin-left: 10px;
        }
        
        .chat-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .chat-header {
            padding: 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--gray-dark);
        }
        
        .chat-title {
            flex: 1;
            margin-left: 15px;
        }
        
        .chat-user {
            font-weight: 500;
            margin-bottom: 3px;
        }
        
        .chat-status {
            font-size: 12px;
            color: var(--gray-text);
        }
        
        .chat-controls {
            display: flex;
            gap: 10px;
        }
        
        .chat-control-btn {
            padding: 8px 12px;
            border-radius: 4px;
            background-color: var(--dark);
            color: var(--gray-text);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
            gap: 5px;
        }
        
        .chat-control-btn:hover {
            background-color: var(--primary);
            color: var(--light-text);
        }
        
        .danger-btn {
            background-color: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }
        
        .danger-btn:hover {
            background-color: var(--danger);
            color: var(--light-text);
        }
        
        .messages-area {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }
        
        .message {
            max-width: 70%;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
        }
        
        .message-content {
            padding: 12px 15px;
            border-radius: 12px;
            position: relative;
        }
        
        .message-time {
            font-size: 12px;
            color: var(--gray-text);
            margin-top: 5px;
            align-self: flex-end;
        }
        
        .message.user-a {
            align-self: flex-start;
        }
        
        .message.user-b {
            align-self: flex-end;
        }
        
        .message.user-a .message-content {
            background-color: var(--gray-dark);
            border-bottom-left-radius: 2px;
        }
        
        .message.user-b .message-content {
            background-color: var(--primary);
            border-bottom-right-radius: 2px;
        }
        
        .message-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 5px;
            font-size: 12px;
        }
        
        .message-user {
            font-weight: 500;
        }
        
        .monitoring-tools {
            padding: 15px 20px;
            border-top: 1px solid var(--gray-dark);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .monitoring-status {
            background-color: rgba(74, 222, 128, 0.1);
            color: var(--success);
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .action-buttons {
            display: flex;
            gap: 10px;
        }
        
        .no-message-selected {
            display: flex;
            flex: 1;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        .no-message-icon {
            font-size: 60px;
            color: var(--gray-text);
            margin-bottom: 20px;
        }
        
        .no-message-text {
            font-size: 18px;
            color: var(--gray-text);
            text-align: center;
        }
        
        .message-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background-color: var(--darker);
            border-radius: 10px;
            padding: 20px;
            flex: 1;
        }
        
        .stat-title {
            color: var(--gray-text);
            font-size: 14px;
            margin-bottom: 15px;
        }
        
        .stat-value {
            font-size: 24px;
            font-weight: 600;
        }
        
        .stat-secondary {
            font-size: 14px;
            color: var(--gray-text);
            margin-top: 5px;
        }
        
        .conversation-info {
            background-color: var(--darker);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .info-title {
            font-size: 18px;
            font-weight: 500;
            margin-bottom: 15px;
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }
        
        .info-item {
            background-color: var(--dark);
            border-radius: 8px;
            padding: 15px;
        }
        
        .info-label {
            color: var(--gray-text);
            font-size: 14px;
            margin-bottom: 8px;
        }
        
        .info-value {
            font-weight: 500;
        }
        
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
        }
        
        .badge-success {
            background-color: rgba(74, 222, 128, 0.1);
            color: var(--success);
        }
        
        .badge-warning {
            background-color: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }
        
        .badge-danger {
            background-color: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <div class="header">
                <div class="welcome">
                    <h2>Message Monitoring</h2>
                    <h4>Monitor conversations between students and recruiters</h4>
                </div>
                <div class="admin-controls">
                    <div class="search-box">
                        <input type="text" placeholder="Search...">
                        <i class="fas fa-search"></i>
                    </div>
                    <div class="admin-profile">
                        <div class="admin-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="admin-info">
                            <div class="admin-name">Srihesh</div>
                            <div class="admin-role">Super Admin</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Message Stats Section -->
            <div class="message-stats">
                <div class="stat-card">
                    <div class="stat-title">Total Active Conversations</div>
                    <div class="stat-value">367</div>
                    <div class="stat-secondary">+24 this week</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">Flagged Conversations</div>
                    <div class="stat-value">12</div>
                    <div class="stat-secondary">-3 from last week</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">Messages Today</div>
                    <div class="stat-value">1,248</div>
                    <div class="stat-secondary">+126 from yesterday</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">Message Response Rate</div>
                    <div class="stat-value">94%</div>
                    <div class="stat-secondary">+2% this month</div>
                </div>
            </div>

            <!-- Messages Section -->
            <div class="messages-container">
                <!-- Contacts Panel -->
                <div class="contacts-panel">
                    <div class="contacts-header">
                        <div class="contacts-title">Active Conversations</div>
                        <div class="filter-dropdown">
                            <button class="filter-btn">
                                <i class="fas fa-filter"></i> Filter
                            </button>
                        </div>
                    </div>
                    
                    <!-- Contact Search -->
                    <div class="contact-search">
                        <input type="text" placeholder="Search conversations..." id="contact-search-input">
                    </div>
                    
                    <!-- Contact List -->
                    <ul class="contact-list" id="contact-list">
                        <!-- Contact items will be populated by JavaScript -->
                    </ul>
                </div>
                
                <!-- Chat Panel -->
                <div class="chat-panel" id="chat-panel">
                    <!-- Initially show the no message selected screen -->
                    <div class="no-message-selected" id="no-message-selected">
                        <div class="no-message-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="no-message-text">
                            <p>Select a conversation to monitor</p>
                            <p style="font-size: 14px; margin-top: 10px;">You can view messages and flag inappropriate content</p>
                        </div>
                    </div>
                    
                    <!-- This will be shown when a chat is selected -->
                    <div class="chat-interface" id="chat-interface" style="display: none; flex-direction: column; height: 100%;">
                        <div class="chat-header">
                            <div class="contact-avatar" id="chat-avatar">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="chat-title">
                                <div class="chat-user" id="chat-user">Conversation Participants</div>
                                <div class="chat-status" id="chat-status">Last activity: Today, 10:30 AM</div>
                            </div>
                            <div class="chat-controls">
                                <button class="chat-control-btn">
                                    <i class="fas fa-file-export"></i> Export
                                </button>
                                <button class="chat-control-btn danger-btn">
                                    <i class="fas fa-flag"></i> Flag
                                </button>
                            </div>
                        </div>
                        
                        <div class="messages-area" id="messages-area">
                            <!-- Messages will be populated by JavaScript -->
                        </div>
                        
                        <div class="monitoring-tools">
                            <div class="monitoring-status">
                                <i class="fas fa-eye"></i> Monitoring Active
                            </div>
                            <div class="action-buttons">
                                <button class="btn btn-outline">
                                    <i class="fas fa-envelope"></i> Send System Message
                                </button>
                                <button class="btn btn-primary">
                                    <i class="fas fa-ban"></i> Block Conversation
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="./mess.js"></script>
</body>
</html>