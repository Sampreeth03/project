<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RELABTeams Projects</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #0068FF;
            --secondary: #0056d6;
            --dark: #121212;
            --darker: #0a0a0a;
            --light-text: #ffffff;
            --gray-text: #a0a0a0;
            --gray-dark: #2a2a2a;
            --success: #4ade80;
            --danger: #ef4444;
            --warning: #f59e0b;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: var(--dark);
            color: var(--light-text);
        }
        
        .container {
            display: flex;
            min-height: 100vh;
        }
        
        .sidebar {
            width: 280px;
            background-color: var(--darker);
            color: var(--light-text);
            padding: 20px 0;
            height: 100vh;
            position: fixed;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 100;
        }
        
        .sidebar-header {
            padding: 0 25px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }
        
        .logo {
            display: flex;
            align-items: center;
            color: var(--light-text);
            text-decoration: none;
        }
        
        .logo img {
            height: 40px;
            margin-right: 10px;
        }
        
        .logo-text {
            font-size: 22px;
            font-weight: 700;
            color: #0068FF;
        }
        
        .nav-menu {
            padding: 10px 0;
        }
        
        .menu-label {
            padding: 0 25px;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--gray-text);
            margin-bottom: 10px;
            margin-top: 20px;
        }
        
        .menu-item {
            padding: 12px 25px;
            display: flex;
            align-items: center;
            color: var(--gray-text);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }
        
        .menu-item:hover {
            color: var(--light-text);
            background-color: rgba(255, 255, 255, 0.05);
        }
        
        .menu-item.active {
            color: var(--light-text);
            background-color: rgba(0, 104, 255, 0.1);
            border-left: 4px solid var(--primary);
        }
        
        .menu-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            font-size: 18px;
        }
        
        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 30px;
            transition: all 0.3s;
            overflow-x: hidden;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .page-title h2 {
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .page-title h4 {
            color: var(--gray-text);
            font-weight: normal;
        }
        
        .admin-controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        .admin-profile {
            display: flex;
            align-items: center;
            cursor: pointer;
        }
        
        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }
        
        .admin-info {
            display: flex;
            flex-direction: column;
        }
        
        .admin-name {
            font-weight: 500;
        }
        
        .admin-role {
            font-size: 12px;
            color: var(--gray-text);
        }
        
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
            margin-top: 25px;
        }
        
        .project-card {
            background-color: var(--darker);
            border-radius: 10px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            opacity: 0;
            transform: translateY(20px);
        }
        
        .project-card.show {
            opacity: 1;
            transform: translateY(0);
        }

        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }
        
        .project-header {
            padding: 20px;
            border-bottom: 1px solid var(--gray-dark);
        }
        
        .project-title {
            font-weight: 600;
            font-size: 18px;
            margin-bottom: 5px;
        }
        
        .project-category {
            color: var(--primary);
            font-size: 14px;
        }
        
        .project-status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 12px;
            margin-top: 10px;
        }
        
        .status-active {
            background-color: rgba(74, 222, 128, 0.2);
            color: var(--success);
        }
        
        .status-completed {
            background-color: rgba(0, 104, 255, 0.2);
            color: var(--primary);
        }

        .status-expired {
            background-color: rgba(239, 68, 68, 0.12);
            color: var(--danger);
        }
        
        .status-pending {
            background-color: rgba(245, 158, 11, 0.2);
            color: var(--warning);
        }
        
        .project-body {
            padding: 20px;
        }
        
        .project-description {
            color: var(--gray-text);
            font-size: 14px;
            margin-bottom: 20px;
            line-height: 1.6;
        }
        
        .project-details {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
        }
        
        .detail-item {
            display: flex;
            justify-content: space-between;
        }
        
        .detail-label {
            color: var(--gray-text);
            font-size: 14px;
        }
        
        .detail-value {
            font-size: 14px;
        }
        
        .project-members {
            display: flex;
            align-items: center;
        }
        
        .member-count {
            color: var(--gray-text);
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar', { activePage: 'projects' }) %>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <div class="header">
                <div class="page-title">
                    <h2>All Projects</h2>
                    <h4>Overview of all RELABTeams projects</h4>
                </div>
                <div class="admin-controls">
                    <div class="admin-profile">
                        <div class="admin-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="admin-info">
                            <div class="admin-name"><%= dashboardData.adminName %></div>
                            <div class="admin-role"><%= dashboardData.adminRole %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Projects Grid -->
            <div id="projectsContainer" class="projects-grid">
                <!-- Projects will be loaded dynamically -->
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const container = document.getElementById("projectsContainer");
            const xhr = new XMLHttpRequest();
            xhr.open("GET", "/api/projects", true);

            xhr.onload = function() {
                if (xhr.status === 200) {
                    const projects = JSON.parse(xhr.responseText);
                    container.innerHTML = "";

                    projects.forEach((project, index) => {
                        const statusLabel = project.status.charAt(0).toUpperCase() + project.status.slice(1);
                        const deadline = new Date(project.deadline).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                        });

                        const card = document.createElement("div");
                        card.classList.add("project-card");
                        card.innerHTML = `
                            <div class="project-header">
                                <div class="project-title">${project.title}</div>
                                <div class="project-category">${project.category}</div>
                                <span class="project-status status-${project.status}">
                                    ${statusLabel}
                                </span>
                            </div>
                            <div class="project-body">
                                <div class="project-description">${project.description || ''}</div>
                                <div class="project-details">
                                    <div class="detail-item">
                                        <span class="detail-label">Deadline:</span>
                                        <span class="detail-value">${deadline}</span>
                                    </div>
                                </div>
                                <div class="project-members">
                                    <div class="member-count">${project.members} Members</div>
                                </div>
                            </div>
                        `;

                        // Delay insertion for cascade effect
                        setTimeout(() => {
                            container.appendChild(card);
                            // add a small delay before making it visible
                            setTimeout(() => card.classList.add("show"), 100);
                        }, index * 150); // 150ms delay between cards
                    });
                } else {
                    container.innerHTML = "<p>Failed to load projects.</p>";
                }
            };

            xhr.onerror = function() {
                container.innerHTML = "<p>Network error while loading projects.</p>";
            };

            xhr.send();
        });
    </script>
</body>
</html>

