<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Dashboard - RELABTeams</title>
    <style>
        :root {
            --dark-bg: #121212;
            --dark-card: #1e1e1e;
            --accent: #0068FF;
            --text: #e0e0e0;
            --secondary-text: #a0a0a0;
            --border: #2d2d2d;
            --gradient: linear-gradient(135deg, #0068FF, #00C4FF);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text);
            min-height: 100vh;
            padding-top: 60px;
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background-color: black;
            padding: 15px 5%;
            display: flex;
            z-index: 1000;
            align-items: center;
            justify-content: flex-start;
            box-sizing: border-box;
        }

        .logo {
            font-size: 30px;
            color: var(--accent);
            font-weight: bold;
            margin-right: 30px;
            flex-shrink: 0;
        }

        #logo-link {
            text-decoration: none;
            color: var(--accent);
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 38px;
            position: relative;
            margin: 0;
            padding: 0;
            flex: 1;
        }

        .nav-links li {
            position: relative;
        }

        .nav-links li a {
            color: white;
            text-decoration: none;
            font-size: 20px;
            transition: color 0.3s ease;
            padding: 10px;
            display: block;
        }

        .nav-links li a:hover {
            color: var(--accent);
        }

        .dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: black;
            min-width: max-content;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
            z-index: 1000;
        }

        .dropdown li {
            width: 100%;
        }

        .dropdown li a {
            padding: 12px;
            font-size: 18px;
            display: block;
            color: white;
            white-space: nowrap;
        }

        .dropdown li a:hover {
            background-color: #333;
            color: var(--accent);
        }

        .nav-links li:hover .dropdown {
            display: block;
        }

        @media screen and (max-width: 700px) {
            .nav-links {
                display: none;
            }

            .nav-links.show {
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                background-color: black;
                display: block;
                text-align: center;
                padding: 0;
                z-index: 100;
                border-bottom: 1px solid var(--accent);
            }

            .nav-links.show a {
                display: block;
                padding: 15px;
                margin: 0;
                border-bottom: 1px solid #333;
            }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px 16px;
            position: relative;
            overflow: hidden;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(0, 104, 255, 0.1), transparent 70%);
            z-index: -1;
        }

        h2 {
            margin-bottom: 32px;
            color: var(--accent);
            font-size: 28px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            display: inline-block;
        }

        h2::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 50%;
            height: 3px;
            background: var(--gradient);
            border-radius: 2px;
        }

        .stats-dashboard {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin: 16px 0;
        }

        .stat-card {
            background: var(--dark-card);
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--gradient);
            opacity: 0.05;
            z-index: 0;
            transition: opacity 0.3s ease;
        }

        .stat-card:hover::before {
            opacity: 0.15;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 104, 255, 0.2);
        }

        .stat-value {
            font-size: 48px;
            font-weight: bold;
            color: var(--accent);
            margin-bottom: 8px;
            position: relative;
            z-index: 1;
            transition: color 0.3s ease;
        }

        .stat-card:hover .stat-value {
            color: #00C4FF;
        }

        .stat-label {
            color: var(--secondary-text);
            font-size: 18px;
            font-weight: 500;
            position: relative;
            z-index: 1;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            animation: fadeIn 1s ease-in-out;
        }

        @keyframes fadeIn {
            0% { opacity: 0; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1); }
        }

        @media (max-width: 768px) {
            .stats-dashboard {
                grid-template-columns: 1fr;
            }

            h2 {
                font-size: 24px;
            }

            .stat-value {
                font-size: 40px;
            }

            .stat-label {
                font-size: 16px;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <div class="logo">
                <a id="logo-link" href="<%= homeUrl %>">RELABTeams</a>
            </div>
            <ul class="nav-links">
                <% navLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>"><%= link.name %></a>
                        <% if (link.submenu) { %>
                            <ul class="dropdown">
                                <% link.submenu.forEach(sublink => { %>
                                    <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        </div>
    </header>

    <div class="container">
        <h2>Recruiter Dashboard</h2>
        <div class="stats-dashboard">
            <div class="stat-card">
                <div class="stat-value" id="total-jobs"><%= totalJobs || 0 %></div>
                <div class="stat-label">Total Jobs Posted</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="total-participants"><%= totalParticipants || 0 %></div>
                <div class="stat-label">Total Participants</div>
            </div>
        </div>
    </div>
</body>
</html>