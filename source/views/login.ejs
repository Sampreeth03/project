<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <!-- ============================================
         ESWAR1 - LOGIN.EJS DOM VALIDATION
         Features Implemented by Eswar:
         1. Email format validation (blur/input)
         2. Password policy validation (blur/input)
         3. Inline error messages
         4. Disable Sign In button until valid
         5. Submit blocking with focus on first invalid field
         6. Caps Lock detection
         7. Email domain suggestions (gmail, yahoo, outlook, etc.)
         8. Focus glow effects
         9. Shake animation on errors
         10. Click-outside detection for suggestions
         ============================================ -->
    <style>
      body {
        background-color: #121212;
        color: #ffffff;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
      }

      .login-container {
        background-color: #1e1e1e;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        width: 400px;
        transition: 0.3s;
      }

      .login-form h2 {
        margin-bottom: 10px;
        text-align: center;
        font-size: 24px;
      }

      .error {
        color: #ff4d4d;
        text-align: center;
        margin-bottom: 15px;
        font-weight: bold;
      }
      .input-group {
        position: relative;
        width: 100%;
      }

      .input-group input {
        display: block;
        width: 100%;
        height: 48px;
        box-sizing: border-box;
        padding: 0 60px 0 15px; /* Right padding for Show button */
        border: 1px solid #1079e9;
        border-radius: 5px;
        background-color: transparent;
        color: #ffffff;
        font-size: 16px;
        font-family: Arial, sans-serif;
        line-height: 48px;      
        outline: none;
        transition: none;       
        letter-spacing: 0;      
        word-spacing: 0;
      }

      .input-group input.input-error::placeholder {
        color: #ff4d4d;
        opacity: 1;
        font-size: 16px;
        font-family: Arial, sans-serif;
        line-height: 48px;
        letter-spacing: 0;
        word-spacing: 0;
      }

      /* allow input groups to expand when inline error messages appear */
      .input-group { /* container for input + inline error */
        width: 100%;
      }
      .input-group input {
        height: 48px;
      }


      .login-btn {
        width: 100%;
        background-color: #0068ff;
        color: #ffffff;
        border: none;
        padding: 12px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        transition: 0.3s;
        margin-top: 10px;
      }

      .login-btn:hover {
        background-color: #144289;
      }

      .signup-text {
        text-align: center;
        margin-top: 10px;
      }

      .signup-text a {
        color: #0068ff;
        text-decoration: underline;
      }

      .toggle-password {
        position: absolute;
        top: 12px; /* Fixed position from top */
        right: 15px;
        cursor: pointer;
        color: #0068ff;
        font-size: 14px;
        font-weight: bold;
        background: none;
        border: none;
        user-select: none;
        pointer-events: auto;
        z-index: 10;
      }

      .toggle-password:hover {
        color: #1f5bb4;
      }
      .field-error {
        color: #ff6b6b;
        font-size: 0.85rem;
        margin-top: 6px;
        min-height: 18px;
        display: none; /* hide by default, show when needed */
      }

      .login-btn[disabled], .login-btn[aria-disabled="true"] {
        opacity: 0.5;
        cursor: not-allowed;
        filter: grayscale(10%);
      }
      input.input-error::placeholder {
        color: #ff6b6b;
        opacity: 1; 
      }

      /* Advanced DOM Features */
      .caps-lock-warning {
        position: absolute;
        right: 50px;
        top: 50%;
        transform: translateY(-50%);
        color: #ffa500;
        font-size: 20px;
        display: none;
        animation: pulse 1.5s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }

      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
        20%, 40%, 60%, 80% { transform: translateX(5px); }
      }

      .shake {
        animation: shake 0.5s;
      }

      .input-group.focused {
        position: relative;
      }

      .input-group.focused::before {
        content: '';
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        background: linear-gradient(45deg, #0068ff, #00a1ff);
        border-radius: 8px;
        z-index: -1;
        opacity: 0.3;
        animation: glow 2s ease-in-out infinite;
      }

      @keyframes glow {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 0.6; }
      }

      .email-suggestion {
        position: absolute;
        background: #2a2a2a;
        border: 1px solid #0068ff;
        border-radius: 4px;
        padding: 8px 12px;
        margin-top: 2px;
        font-size: 13px;
        color: #ccc;
        cursor: pointer;
        z-index: 1000;
        display: none;
        transition: all 0.2s;
      }

      .email-suggestion:hover {
        background: #0068ff;
        color: white;
      }

      .email-suggestion strong {
        color: #0068ff;
      }

      .email-suggestion:hover strong {
        color: white;
      }
    </style>
  </head>
  <body>
    <div class="login-container">
      <form class="login-form" action="/login" method="POST">
        <h2>Login</h2>

        <% if (error) { %>
        <p class="error"><%= error %></p>
        <% } %>

        <div class="input-group" id="email-group">
          <input id="email" type="email" name="email" placeholder="Email" required aria-describedby="email-error" />
          <div class="email-suggestion" id="email-suggestion"></div>
          <div id="email-error" class="field-error" aria-live="polite"></div>
        </div><br>
        <div class="input-group" id="password-group">
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Password"
            required
            aria-describedby="password-error"
          />
          <span class="caps-lock-warning" id="caps-warning" style="margin-right: 10px; margin-bottom: 10px;">⇪ Caps</span>
          <span
            id="toggle-password-btn"
            class="toggle-password"
            >Show</span
          >
          <div id="password-error" class="field-error" aria-live="polite"></div>
        </div>

        <button type="submit" id="login-btn" class="login-btn" aria-disabled="true" disabled>Login</button>

        <p class="signup-text">
          Don't have an account? <a href="/signup">Sign Up</a>
        </p>
      </form>
    </div>
    <script>
      function togglePassword(id, element) {
        var input = document.getElementById(id);
        if (input.type === "password") {
          input.type = "text";
          element.textContent = "Hide";
        } else {
          input.type = "password";
          element.textContent = "Show";
        }
      }
    </script>
     <!--E1-->
    <!-- ============================================
         ESWAR1 - LOGIN VALIDATION JAVASCRIPT START
         All validation logic below implemented by Eswar
         ============================================ -->
    <script>
      (function() {
        // ESWAR1: Element references for validation
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');
        const emailError = document.getElementById('email-error');
        const passwordError = document.getElementById('password-error');
        const loginBtn = document.getElementById('login-btn');
        const toggleBtn = document.getElementById('toggle-password-btn');
        const emailGroup = document.getElementById('email-group');
        const passwordGroup = document.getElementById('password-group');
        const emailSuggestion = document.getElementById('email-suggestion');
        const capsWarning = document.getElementById('caps-warning');

        // Email domain suggestions
        const commonDomains = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com'];

        // Caps Lock detection
        passwordInput.addEventListener('keyup', function(e) {
          if (e.getModifierState && e.getModifierState('CapsLock')) {
            capsWarning.style.display = 'block';
          } else {
            capsWarning.style.display = 'none';
          }
        });

        // Focus highlighting
        emailInput.addEventListener('focus', function() {
          emailGroup.classList.add('focused');
        });

        emailInput.addEventListener('blur', function() {
          emailGroup.classList.remove('focused');
        });

        passwordInput.addEventListener('focus', function() {
          passwordGroup.classList.add('focused');
        });

        passwordInput.addEventListener('blur', function() {
          passwordGroup.classList.remove('focused');
          capsWarning.style.display = 'none';
        });

        // Email domain suggestion
        emailInput.addEventListener('input', function() {
          const value = this.value.trim();
          const atIndex = value.indexOf('@');
          
          if (atIndex > 0 && atIndex < value.length - 1) {
            const domain = value.substring(atIndex + 1);
            const matchedDomain = commonDomains.find(d => d.startsWith(domain) && d !== domain);
            
            if (matchedDomain) {
              const username = value.substring(0, atIndex);
              emailSuggestion.innerHTML = `Did you mean <strong>${username}@${matchedDomain}</strong>?`;
              emailSuggestion.style.display = 'block';
              
              emailSuggestion.onclick = function() {
                emailInput.value = username + '@' + matchedDomain;
                emailSuggestion.style.display = 'none';
                emailInput.dispatchEvent(new Event('input'));
              };
            } else {
              emailSuggestion.style.display = 'none';
            }
          } else {
            emailSuggestion.style.display = 'none';
          }
        });

        // Hide suggestion when clicking outside
        document.addEventListener('click', function(e) {
          if (e.target !== emailInput && e.target !== emailSuggestion) {
            emailSuggestion.style.display = 'none';
          }
        });

        // Shake animation on submit error
        function shakeElement(element) {
          element.classList.add('shake');
          setTimeout(() => {
            element.classList.remove('shake');
          }, 500);
        }

        function validateEmail(value) {
          if (!value) return 'Email is required.';
          const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          return re.test(value) ? '' : 'Enter a valid email address.';
        }

        function validatePassword(value) {
          if (!value) return 'Password is required.';
          const re = /^(?=.*[A-Z])(?=.*[!@#$%^&*])[A-Za-z\d!@#$%^&*]{6,}$/;
          return re.test(value) ? '' : 'Password must satisfy criteria.';
        }

        function updateButtonState() {
          const emailValid = !validateEmail(emailInput.value);
          const passValid = !validatePassword(passwordInput.value);
          if (emailValid && passValid) {
            loginBtn.removeAttribute('disabled');
            loginBtn.setAttribute('aria-disabled', 'false');
          } else {
            loginBtn.setAttribute('disabled', '');
            loginBtn.setAttribute('aria-disabled', 'true');
          }
        }

        const originalEmailPlaceholder = emailInput.getAttribute('placeholder') || '';
        const originalPasswordPlaceholder = passwordInput.getAttribute('placeholder') || '';

        function applyInlinePlaceholderError(inputEl, errorEl, message, originalPlaceholder) {
          if (!message) {
            inputEl.classList.remove('input-error');
            inputEl.setAttribute('placeholder', originalPlaceholder);
            errorEl.textContent = '';
            return;
          }
          inputEl.classList.add('input-error');
          inputEl.setAttribute('placeholder', originalPlaceholder);
          // For password criteria failures show a visible detailed message under the field
          if (errorEl && errorEl.id === 'password-error' && /password/i.test(message)) {
            errorEl.textContent = 'Password must be at least 6 characters and include one uppercase letter and one special character.';
            // show as normal block so it pushes content down
            errorEl.style.display = 'block';
          } else {
            // keep the placeholder-style inline error for other fields (hidden summary)
            errorEl.textContent = message;
            errorEl.style.display = 'block';
          }
        }

        function clearInlinePlaceholderError(inputEl, errorEl, originalPlaceholder) {
          inputEl.classList.remove('input-error');
          if (inputEl.getAttribute('placeholder') !== originalPlaceholder) {
            inputEl.setAttribute('placeholder', originalPlaceholder);
          }
          errorEl.textContent = '';
          errorEl.style.display = 'none';
        }

        function onEmailBlur() {
          const msg = validateEmail(emailInput.value.trim());
          applyInlinePlaceholderError(emailInput, emailError, msg, originalEmailPlaceholder);
          if (msg) {
            shakeElement(emailGroup);
          }
          updateButtonState();
        }

        function onPasswordBlur() {
          const msg = validatePassword(passwordInput.value);
          applyInlinePlaceholderError(passwordInput, passwordError, msg, originalPasswordPlaceholder);
          if (msg) {
            shakeElement(passwordGroup);
          }
          updateButtonState();
        }

        emailInput.addEventListener('blur', onEmailBlur);
        passwordInput.addEventListener('blur', onPasswordBlur);

        emailInput.addEventListener('focus', function() {
          clearInlinePlaceholderError(emailInput, emailError, originalEmailPlaceholder);
        });
        passwordInput.addEventListener('focus', function() {
          clearInlinePlaceholderError(passwordInput, passwordError, originalPasswordPlaceholder);
        });

        emailInput.addEventListener('input', function() {
          clearInlinePlaceholderError(emailInput, emailError, originalEmailPlaceholder);
          updateButtonState();
        });
        passwordInput.addEventListener('input', function() {
          clearInlinePlaceholderError(passwordInput, passwordError, originalPasswordPlaceholder);
          updateButtonState();
        });

        // wire toggle password control
        if (toggleBtn) {
          toggleBtn.addEventListener('mousedown', function(e) {
          e.preventDefault();
          togglePassword('password', this);
        });
        }

        updateButtonState();

        const form = document.querySelector('.login-form');
        if (form) {
          form.addEventListener('submit', function (e) {
            const emailMsg = validateEmail(emailInput.value.trim());
            const passMsg = validatePassword(passwordInput.value);
            if (emailMsg || passMsg) {
              e.preventDefault();
              if (emailMsg) {
                applyInlinePlaceholderError(emailInput, emailError, emailMsg, originalEmailPlaceholder);
                shakeElement(emailGroup);
                emailInput.focus();
              }
              if (!emailMsg && passMsg) {
                applyInlinePlaceholderError(passwordInput, passwordError, passMsg, originalPasswordPlaceholder);
                shakeElement(passwordGroup);
                passwordInput.focus();
              }
              if (emailMsg && passMsg) {
                shakeElement(passwordGroup);
              }
              updateButtonState();
              return false;
            }
            loginBtn.setAttribute('disabled', '');
            loginBtn.setAttribute('aria-disabled', 'true');
            loginBtn.textContent = 'Signing in...';
            return true;
          });
        }
      })();
      // ============================================
      // ESWAR1 - LOGIN VALIDATION JAVASCRIPT END
      // ============================================
    </script>
  </body>
</html>