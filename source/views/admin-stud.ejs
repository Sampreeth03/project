<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RELABTeams Admin - Students Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #0068FF;
            --secondary: #0056d6;
            --dark: #121212;
            --darker: #0a0a0a;
            --light-text: #ffffff;
            --gray-text: #a0a0a0;
            --gray-dark: #2a2a2a;
            --success: #4ade80;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--dark);
            color: var(--light-text);
        }

        .container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            background-color: var(--darker);
            color: var(--light-text);
            padding: 20px 0;
            height: 100vh;
            position: fixed;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 100;
            display: block;
        }

        .sidebar-collapsed {
            width: 80px;
        }

        .sidebar-collapsed .logo-text,
        .sidebar-collapsed .menu-label,
        .sidebar-collapsed .menu-item span {
            display: none;
        }

        .sidebar-collapsed .menu-item {
            justify-content: center;
        }

        .sidebar-collapsed .menu-item i {
            margin-right: 0;
        }

        .sidebar-header {
            padding: 0 25px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sidebar-toggler {
            color: var(--gray-text);
            background: none;
            border: none;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-toggler:hover {
            color: var(--light-text);
        }

        .logo {
            display: flex;
            align-items: center;
            color: var(--light-text);
            text-decoration: none;
        }

        .logo img {
            height: 40px;
            margin-right: 10px;
        }

        .logo-text {
            font-size: 22px;
            font-weight: 700;
            text-decoration: none;
            color: #0068FF;
        }

        .nav-menu {
            padding: 10px 0;
        }

        .menu-label {
            padding: 0 25px;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--gray-text);
            margin-bottom: 10px;
            margin-top: 20px;
        }

        .menu-item {
            padding: 12px 25px;
            display: flex;
            align-items: center;
            color: var(--gray-text);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }

        .menu-item:hover {
            color: var(--light-text);
            background-color: rgba(255, 255, 255, 0.05);
        }

        .menu-item.active {
            color: var(--light-text);
            background-color: rgba(0, 104, 255, 0.1);
            border-left: 4px solid var(--primary);
        }

        .menu-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            font-size: 18px;
        }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 30px;
            transition: all 0.3s;
            overflow-x: hidden;
        }

        .main-content-expanded {
            margin-left: 80px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title h2 {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .breadcrumb {
            color: var(--gray-text);
            font-size: 14px;
        }

        .breadcrumb a {
            color: var(--primary);
            text-decoration: none;
        }

        .admin-controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .search-box {
            position: relative;
            width: 300px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 40px 10px 15px;
            border-radius: 8px;
            border: 1px solid var(--gray-dark);
            background-color: var(--darker);
            color: var(--light-text);
            outline: none;
        }

        .search-box input::placeholder {
            color: var(--gray-text);
        }

        .search-box i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-text);
        }

        .admin-profile {
            display: flex;
            align-items: center;
            cursor: pointer;
            position: relative;
        }

        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }

        .admin-info {
            display: flex;
            flex-direction: column;
        }

        .admin-name {
            font-weight: 500;
        }

        .admin-role {
            font-size: 12px;
            color: var(--gray-text);
        }

        .profile-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            width: 200px;
            background-color: var(--darker);
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            padding: 10px 0;
            z-index: 100;
            display: none;
        }

        .profile-dropdown.show {
            display: block;
        }

        .profile-dropdown a {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            color: var(--light-text);
            text-decoration: none;
            transition: all 0.2s;
        }

        .profile-dropdown a:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .profile-dropdown a i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        .profile-dropdown hr {
            border: none;
            border-top: 1px solid var(--gray-dark);
            margin: 5px 0;
        }

        .students-table {
            background-color: var(--darker);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table-header {
            padding: 20px 25px;
            border-bottom: 1px solid var(--gray-dark);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-title {
            font-size: 18px;
            font-weight: 500;
            margin: 0;
        }

        .table-controls {
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .btn-primary {
            background-color: var(--primary);
            color: var(--light-text);
        }

        .btn-primary:hover {
            background-color: var(--secondary);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--light-text);
            border: 1px solid var(--gray-dark);
        }

        .btn-outline:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .btn-danger {
            background-color: var(--danger);
            color: var(--light-text);
        }

        .btn-danger:hover {
            background-color: #dc2626;
        }

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px 25px;
            text-align: left;
            border-bottom: 1px solid var(--gray-dark);
        }

        tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background-color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: var(--light-text);
        }

        .user-details {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            font-weight: 500;
        }

        .user-email {
            font-size: 12px;
            color: var(--gray-text);
        }

        .pagination {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding: 20px 25px;
        }

        .page-info {
            color: var(--gray-text);
            font-size: 14px;
        }

        @media (max-width: 992px) {
            .sidebar {
                width: 80px;
            }

            .logo-text,
            .menu-label,
            .menu-item span {
                display: none;
            }

            .menu-item {
                justify-content: center;
                padding: 12px 0;
            }

            .menu-item i {
                margin-right: 0;
            }

            .main-content {
                margin-left: 80px;
            }

            .search-box {
                width: 200px;
            }
        }

        @media (max-width: 768px) {
            .admin-controls {
                width: 100%;
                justify-content: flex-end;
            }

            .search-box {
                width: 100%;
                position: absolute;
                top: 80px;
                left: 0;
                padding: 0 30px;
                z-index: 50;
                display: none;
            }

            .search-box.active {
                display: block;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
                position: relative;
            }

            .admin-controls {
                align-self: flex-end;
            }

            .search-toggle {
                display: block;
            }

            .admin-info {
                display: none;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <div class="main-content" id="main-content">
        <div class="header">
            <div class="page-title">
                <h2>Students Management</h2>
                <div class="breadcrumb">Students</div>
            </div>
            <div class="admin-controls">
                <div class="search-box" id="search-box">
                    <input type="text" id="student-search" placeholder="Search students...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="action-btn" id="search-toggle"><i class="fas fa-search"></i></div>
                <div class="admin-profile" id="admin-profile">
                    <div class="admin-avatar"><i class="fas fa-user"></i></div>
                    <div class="admin-info">
                        <div class="admin-name"><%= adminName %></div>
                        <div class="admin-role">Admin</div>
                    </div>
                    <div class="profile-dropdown" id="profile-dropdown">
                        <a href="/login"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Students Table -->
        <div class="students-table">
            <table>
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Hosted Projects</th>
                        <th>Tasks Completed</th>
                    </tr>
                </thead>
                <tbody id="students-tbody"></tbody>
            </table>
            <div id="students-empty" style="display:block; padding:20px; text-align:center; color:var(--gray-text);">
                Loading students...
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const tbody = document.getElementById('students-tbody');
    const emptyNotice = document.getElementById('students-empty');

    function createStudentRow(student) {
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', student.id || '');

        const tdStudent = document.createElement('td');
        const userInfo = document.createElement('div'); userInfo.className = 'user-info';
        const userAvatar = document.createElement('div'); userAvatar.className = 'user-avatar';
        userAvatar.textContent = (student.name || '').split(' ').map(n => n[0] || '').join('');
        const userDetails = document.createElement('div'); userDetails.className = 'user-details';
        const userName = document.createElement('div'); userName.className = 'user-name'; userName.textContent = student.name || '';
        const userEmail = document.createElement('div'); userEmail.className = 'user-email'; userEmail.textContent = student.email || '';
        userDetails.appendChild(userName); userDetails.appendChild(userEmail);
        userInfo.appendChild(userAvatar); userInfo.appendChild(userDetails);
        tdStudent.appendChild(userInfo);

        const tdHosted = document.createElement('td'); tdHosted.textContent = student.hostedProjects || 0;
        const tdTasks = document.createElement('td'); tdTasks.textContent = student.tasksCompleted || 0;

        tr.appendChild(tdStudent); tr.appendChild(tdHosted); tr.appendChild(tdTasks);
        return tr;
    }

    function populateTable(data) {
        tbody.innerHTML = '';
        if (!data || data.length === 0) {
            emptyNotice.style.display = 'block';
            emptyNotice.textContent = 'No students found.';
            return;
        }
        emptyNotice.style.display = 'none';
        data.forEach((student, index) => {
            setTimeout(() => {
                tbody.appendChild(createStudentRow(student));
            }, 80 * (index + 1));
        });
    }

    function fetchStudents() {
        const xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/students', true);
        xhr.onreadystatechange = function() {
            if (xhr.readyState === 4) {
                if (xhr.status === 200) {
                    const studentsData = JSON.parse(xhr.responseText);
                    populateTable(studentsData);
                } else {
                    emptyNotice.style.display = 'block';
                    emptyNotice.textContent = 'Failed to load students.';
                }
            }
        };
        xhr.send();
    }

    fetchStudents();

    // Search
    const searchInput = document.getElementById('student-search');
    if (searchInput) {
        searchInput.addEventListener('input', () => {
            const query = (searchInput.value || '').toLowerCase();
            const filteredRows = Array.from(tbody.children).filter(row => {
                const name = row.querySelector('.user-name')?.textContent.toLowerCase() || '';
                const email = row.querySelector('.user-email')?.textContent.toLowerCase() || '';
                return name.includes(query) || email.includes(query);
            });
            tbody.innerHTML = '';
            if (filteredRows.length === 0) {
                emptyNotice.style.display = 'block';
                emptyNotice.textContent = 'No students found.';
            } else {
                emptyNotice.style.display = 'none';
                filteredRows.forEach(row => tbody.appendChild(row));
            }
        });
    }
    

    // Sidebar & Profile dropdown
    const adminProfile = document.getElementById('admin-profile');
    const profileDropdown = document.getElementById('profile-dropdown');
    if (adminProfile && profileDropdown) {
        adminProfile.addEventListener('click', () => profileDropdown.classList.toggle('show'));
        document.addEventListener('click', e => { if (!adminProfile.contains(e.target)) profileDropdown.classList.remove('show'); });
    }
});
</script>
</body>
</html>
