<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Profile</title>
    <style>
        body {
            font-family: Arial, sans-serif;
           
            justify-content: center;
            align-items: center;
            background-color: #111;
            margin: 0;
            padding: 0;
            padding-top: 9vh;
           
        }
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background-color: black;
            padding: 15px 5%;
            display: flex;
            z-index: 1000;
            align-items: center;
            justify-content: flex-start;
            box-sizing: border-box;
        }
        
        .logo {
            font-size: 30px;
            color: #0068FF;
            font-weight: bold;
            margin-right: 30px;
            flex-shrink: 0;
        }
        
        #logo-link {
            text-decoration: none;
            color: #0068FF;
        }
        
        .nav-links {
            list-style: none;
            display: flex;
            gap: 38px;
            position: relative;
            margin: 0;
            padding: 0;
            flex: 1;
        }
        
        .nav-links li {
            position: relative;
        }
        
        .nav-links li a {
            color: white;
            text-decoration: none;
            font-size: 20px;
            transition: color 0.3s ease;
            padding: 10px;
            display: block;
        }
        
        .nav-links li a:hover {
            color: #0068FF;
        }
        
        .dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: black;
            min-width: max-content;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
            z-index: 1000;
        }
        
        .dropdown li {
            width: 100%;
        }
        
        .dropdown li a {
            padding: 12px;
            font-size: 18px;
            display: block;
            color: white;
            white-space: nowrap;
        }
        
        .dropdown li a:hover {
            background-color: #333;
            color: #0068FF;
        }
        
        .nav-links li:hover .dropdown {
            display: block;
        }
        
        .search-box {
            padding: 8px;
            border-radius: 5px;
            border: none;
            outline: none;
            width: 205px;
            background-color: #222;
            color: white;
        }
        
@media screen and (max-width: 700px) {
.nav-links {
                display: none;
            }
            
            .menu-btn {
                display: block;
            }
            
            .nav-links.show {
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                background-color: black;
                display: block;
                text-align: center;
                padding: 0;
                z-index: 100;
                border-bottom: 1px solid #0068FF;
            }
            
            .nav-links.show a {
                display: block;
                padding: 15px;
                margin: 0;
                border-bottom: 1px solid #333;
            }}
        .profile-container {
            background: #111;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            color: #ffffff;
            width: 1450px;
            position: relative;
        }
        .profile-header {
            display: flex;
            align-items: center;
        }
        .company-logo {
            width: 200px;
            height: 200px;
            border: 2px solid #ffffff;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .company-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }
        .upload-button {
            cursor: pointer;
            font-size: 1.25rem;
            line-height: 1.5rem;
            padding: 0.625rem 1rem;
            color: rgb(242 242 242);
            background-color: #0069ff;
            font-weight: 600;
            border-radius: 0.5rem;
            border-style: none;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.35s linear;
        }
        .upload-button:hover {
            box-shadow: inset 0 5px 25px 0px #00ddeb;
        }
        .edit-icon {
            position: absolute;
            top: 10px;
            right: 10px;
            opacity: 0;
            transition: opacity 0.3s ease;
            cursor: pointer;
        }
        .company-logo:hover .edit-icon {
            opacity: 1;
        }
        .upload-button svg, .edit-icon svg {
            width: 1.25rem;
            height: 1.25rem;
        }
        .recruiter-info {
            margin-left: 20px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            font-size: 25px;
        }
        .recruiter-info h1, .recruiter-info h2 {
            margin: 0;
        }
        .profile-main {
            padding: 20px;
        }
        .stats {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            color: #0068ff;
        }
        .stat-item {
            text-align: center;
        }
        .stat-item h3 {
            margin-bottom: 5px;
        }
        .company-description, .contact-info {
            margin-bottom: 20px;
        }
        .posted-jobs{
            margin-bottom: 20px;
            font-size:20px;
        }
        .menu-btn {
            display: none;
            float: right;
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            padding-top: 25px;
            padding-right: 15px;
        }
        @media screen and (max-width: 700px) {
            .nav-links {
                display: none;
            }
            
            .menu-btn {
                display: block;
            }
            
            .nav-links.show {
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                background-color: black;
                display: block;
                text-align: center;
                padding: 0;
                z-index: 100;
                border-bottom: 1px solid #0068FF;
            }
            
            .nav-links.show a {
                display: block;
                padding: 15px;
                margin: 0;
                border-bottom: 1px solid #333;
            }
        }
        /* Add these responsive CSS rules to the existing stylesheet without changing anything else */

@media screen and (max-width: 1500px) {
    .profile-container {
        width: 95%;
        margin: 0 auto;
    }
}

@media screen and (max-width: 992px) {
    .profile-header {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    
    .recruiter-info {
        margin-left: 0;
        margin-top: 20px;
        align-items: center;
    }
    
    .stats {
        flex-wrap: wrap;
    }
    
    .stat-item {
        width: 45%;
        margin-bottom: 15px;
    }
}

@media screen and (max-width: 768px) {
    .profile-main {
        padding: 15px 10px;
    }
    
    .stats {
        flex-direction: column;
        align-items: center;
    }
    
    .stat-item {
        width: 100%;
        margin-bottom: 20px;
    }
    
    .recruiter-info {
        font-size: 20px;
    }
    
    .company-logo {
        width: 150px;
        height: 150px;
    }
}

@media screen and (max-width: 480px) {
    .profile-container {
        padding: 10px;
    }
    
    .company-logo {
        width: 120px;
        height: 120px;
    }
    
    .recruiter-info {
        font-size: 18px;
    }
    
    .posted-jobs {
        font-size: 16px;
    }
    
    .upload-button {
        font-size: 1rem;
        padding: 0.5rem 0.75rem;
    }
}

/* Improve list display on small screens */
@media screen and (max-width: 576px) {
    .posted-jobs ul {
        padding-left: 20px;
    }
    
    .posted-jobs li {
        margin-bottom: 10px;
    }
}

/* Additional touch-friendly improvements */
@media (hover: none) and (pointer: coarse) {
    .upload-button, .edit-icon {
        padding: 12px;
    }
    
    .nav-links a {
        padding: 12px 0;
    }
}
    </style>
</head>
<body>
    <div class="navbar">
        <div class="logo">
            <a id="logo-link" href="<%= homeUrl %>">RELABTeams</a>
        </div>
        <ul class="nav-links">
            <% navLinks.forEach(link => { %>
                <li>
                    <a href="<%= link.href %>"><%= link.name %></a>
                    <% if (link.submenu) { %>
                        <ul class="dropdown">
                            <% link.submenu.forEach(sublink => { %>
                                <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                            <% }) %>
                        </ul>
                    <% } %>
                </li>
            <% }) %>
        </ul>
    </div>


    <div class="profile-container" id="recruiter-profile">
        <header class="profile-header">
            <div class="company-logo">
                <img id="profileImage" src="" alt="Company Logo">
                <button class="upload-button" id="uploadButton" onclick="document.getElementById('fileInput').click()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1.25rem" height="1.25rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                        <path d="M12 19v-7m0 0V5m0 7H5m7 0h7"></path>
                    </svg>
                </button>
                <div class="edit-icon" id="editIcon" onclick="document.getElementById('fileInput').click()" style="display: none;">
                    <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M14 4.182A4.136 4.136 0 0 1 16.9 3c1.087 0 2.13.425 2.899 1.182A4.01 4.01 0 0 1 21 7.037c0 1.068-.43 2.092-1.194 2.849L18.5 11.214l-5.8-5.71 1.287-1.31.012-.012Zm-2.717 2.763L6.186 12.13l2.175 2.141 5.063-5.218-2.141-2.108Zm-6.25 6.886-1.98 5.849a.992.992 0 0 0 .245 1.026 1.03 1.03 0 0 0 1.043.242L10.282 19l-5.25-5.168Zm6.954 4.01 5.096-5.186-2.218-2.183-5.063 5.218 2.185 2.15Z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <input type="file" id="fileInput" accept="image/*" style="display: none;" onchange="handleFileUpload(event)">
            </div>
            <div class="recruiter-info">
                <h2>Shiva Sai Prasad Jalla</h2>
                <br>
                <h2>Google</h2>
            </div>
        </header>
        <br>
        <hr>
        <main class="profile-main">
            <div class="stats">
                <div class="stat-item">
                    <h2>Projects Given</h2>
                    <p style="color: white;">10</p>
                </div>
                <div class="stat-item">
                    <h2>Jobs Given</h2>
                    <p style="color: white;">5</p>
                </div>
                <div class="stat-item">
                    <h2>Students Interested</h2>
                    <p style="color: white;">20</p>
                </div>
                <div class="stat-item">
                    <h2>Students </h2>
                    <p style="color: white;">10</p>
                </div>
            </div>
            <hr>
            <div class="company-description">
                <h2 style="color: #0068ff;">About the Company</h2>
                <p>Google is an American search engine company, founded in 1998 by Sergey Brin and Larry Page.</p>
            </div>
            <div class="contact-info">
                <h2 style="color: #0068ff;">Contact Information</h2>
                <p>Email: recruiter@company.com</p>
                <p>Phone: +123 456 7890</p>
            </div>
            <div class="posted-jobs">
                <h2 style="color: #0068ff;">Posted Jobs</h2>
                <ul>
                    <li>Product Manager</li>
                    <li>Software Engineer</li>
                    <li>Data Scientist</li>
                </ul>
            </div>
        </main>
    </div>

    <script>
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const profileImage = document.getElementById('profileImage');
                    const uploadButton = document.getElementById('uploadButton');
                    const editIcon = document.getElementById('editIcon');
                    profileImage.src = e.target.result;
                    profileImage.style.display = 'block';
                    uploadButton.style.display = 'none';
                    editIcon.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }
        if (menuButton) {
            menuButton.onclick = function() {
                if (navMenu.className === "nav-links") {
                    navMenu.className = "nav-links show";
                } else {
                    navMenu.className = "nav-links";
                }
            };
        }
    </script>
</body>
</html>