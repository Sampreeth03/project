<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Robotics Projects</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: black;
            color: white;
            margin: 0;
            padding: 20px;
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background-color: black;
            padding: 15px 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 1000;
        }

        .logo {
            font-size: 30px;
            color: #0068FF;
            font-weight: bold;
            margin-right: 30px;
        }

        #logo-link {
            text-decoration: none;
            color: #0068FF;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 38px;
            margin: 0 auto;
            padding: 0;
            flex-grow: 1;
            justify-content: center;
        }

        .nav-links li {
            position: relative;
        }

        .nav-links li a {
            color: white;
            text-decoration: none;
            font-size: 20px;
            transition: color 0.3s ease;
            padding: 10px;
            display: block;
        }

        .nav-links li a:hover {
            color: #0068FF;
        }

        .dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: black;
            min-width: max-content;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
            z-index: 1000;
        }

        .dropdown li {
            width: 100%;
        }

        .dropdown li a {
            padding: 12px;
            font-size: 18px;
            display: block;
            color: white;
            white-space: nowrap;
        }

        .dropdown li a:hover {
            background-color: #333;
            color: #0068FF;
        }

        .nav-links li:hover .dropdown {
            display: block;
        }

        /* Topics Dropdown Styling */
        .topics-dropdown {
            position: relative;
            margin-left: 20px; /* Spacing between heading and dropdown remains unchanged */
        }

        .dropdown-btn {
            width: 100px;
            padding: 8px 12px;
            background-color: transparent;
            color: #0088ff;
            border: 1px solid #0088ff;
            cursor: pointer;
            border-radius: 4px;
            font-size: 20px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #121212;
            min-width: 200px;
            box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.5);
            z-index: 1;
            border-radius: 4px;
            border: 1px solid #333;
            top: 100%;
            left: 0; /* Aligns dropdown content with the left of the button */
        }

        .dropdown-content a {
            color: white;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }

        .dropdown-content a:hover {
            background-color: #333;
            color: #0088ff;
            border-radius: 4px;
        }

        .topics-dropdown:hover .dropdown-content {
            display: block;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding-top: 80px;
        }

        /* New container for the heading and dropdown to align them side by side */
        .header-container {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px; /* Reduced from 30px to 10px to decrease the distance */
        }

        h1 {
            margin-top: 0;
            text-align: center;
            color: #0068FF;
            margin-bottom: 0; /* Remove bottom margin since header-container handles spacing */
        }

        .project-list {
            display: flex;
            flex-direction: column;
            gap: 30px;
            padding-top: 0.01px;
        }

        .project-card {
            background-color: #111;
            border-radius: 8px;
            padding-left: 20px;
            padding-top: 20px;
            padding-right: 20px;
            border: 1px solid #333;
            transition: transform 0.3s;
            width: 100%;
            height: 250px;
        }

        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px white;
        }

        .project-title {
            color: #0068FF;
            margin-top: 0;
            font-size: 30px;
        }

        .project-description {
            color: #ccc;
            margin-bottom: 15px;
            line-height: 2;
        }

        .project-meta {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 0.9rem;
            color: #888;
        }

        .posted-by {
            color: #aaa;
        }

        .capacity {
            color: #aaa;
            font-size: 20px;
        }

        .join-btn {
            background-color: orange;
            color: black;
            border: none;
            border-radius: 4px;
            padding: 8px 16px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.3s;
        }

        .join-btn:hover:not(:disabled) {
            background-color: #ff8c00;
        }

        .join-btn:disabled {
            background-color: #555;
            color: #888;
            cursor: not-allowed;
        }

        .filled-capacity {
            color: #0068FF;
            font-weight: bold;
        }

        .total-capacity {
            color: orange;
        }

        .header-accent {
            display: block;
            height: 3px;
            width: 60px;
            background-color: orange;
            margin: 0 auto 10px; /* Reduced from 30px to 10px to decrease the distance */
        }
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <span class="logo"><a id="logo-link" href="<%= homeUrl %>">RELABTeams</a></span>
            <ul class="nav-links">
                <% navLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>"><%= link.name %></a>
                        <% if (link.submenu) { %>
                            <ul class="dropdown">
                                <% link.submenu.forEach(sublink => { %>
                                    <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        </div>
    </header>
    <div class="container">
        <div class="header-container">
            <h1>Robotics Projects</h1>
            <div class="topics-dropdown">
                <button class="dropdown-btn" id="topicsButton">Topics</button>
                <div id="topicsDropdown" class="dropdown-content">
                    <a href="/web-dev">Web Development</a>
                    <a href="/cyb">Cyber Security</a>
                    <a href="/dl">Deep Learning</a>
                    <a href="/robo">Robotics</a>
                    <a href="/ds">Data Science</a>
                    <a href="/blockchain">Blockchain</a>
                </div>
            </div>
        </div>
        <span class="header-accent"></span>
        <div class="project-list" id="projectList">
            <% if (projects.length === 0) { %>
                <p>No Robotics projects available yet.</p>
            <% } else { %>
                <% projects.forEach(project => { %>
                    <div class="project-card" data-project-id="<%= project._id %>">
                        <h2 class="project-title"><%= project.title %></h2>
                        <p class="project-description"><%= project.description %></p>
                        <div class="project-meta">
                            <span class="posted-by">Posted by: <%= project.createdBy || 'Unknown' %></span>
                            <span class="capacity">Capacity: 
                                <span class="filled-capacity"><%= project.memberCount || 0 %></span>/
                                <span class="total-capacity"><%= project.capacity %></span>
                            </span>
                        </div>
                        <button class="join-btn" 
                                onclick="joinProject(this, '<%= project._id %>')" 
                                <%= (project.hasJoined || project.hasPendingRequest || project.memberCount >= project.capacity) ? 'disabled' : '' %>>
                            <%= project.hasJoined ? 'Joined' : project.hasPendingRequest ? 'Request Pending' : 'Request to Join Project' %>
                        </button>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
    <script>
        var dropdownButton = document.getElementById("topicsButton");
        var dropdownMenu = document.getElementById("topicsDropdown");

        dropdownButton.addEventListener("click", function() {
            dropdownMenu.style.display = dropdownMenu.style.display !== "block" ? "block" : "none";
        });

        document.addEventListener("click", function(event) {
            if (event.target !== dropdownButton) dropdownMenu.style.display = "none";
        });

        dropdownMenu.addEventListener("click", function(event) {
            event.stopPropagation();
        });

        function joinProject(button, projectId) {
            fetch('/join-project', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ projectId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    button.textContent = "Request Pending";
                    button.disabled = true;
                    location.reload();
                } else {
                    alert(data.message || 'Failed to join project');
                }
            })
            .catch(error => {
                console.error('Error joining project:', error);
                alert('An error occurred while joining the project');
            });
        }
    </script>
</body>
</html>