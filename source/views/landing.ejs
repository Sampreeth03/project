<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RELABTeams</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
    
      #topBtn {
        height:50px;
        width:200px;
        display: none; 
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 50;
        background-color: black;
        color: white;
        border: none;
        padding: 10px 15px;
        font-size: 25px;
        border-radius: 0px;
        transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out, transform 0.2s ease-in-out;
        outline: none;
        padding-top: 0.5px;
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
      }

      
      #topBtn:hover {
        background-color: white;
        color: #0068FF;
      }

    
      #topBtn::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: transparent;
      }

    
      #topBtn:focus {
        outline: none;
        box-shadow: none;
      }

  
      #particles-js {
        position: fixed;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: -1;
        background-color: transparent;
      }
      * {
        color: white;
      }
      #particles-js{
        height:100%;
      }
      body {
        background-color:black;
      }
      .Relabteams{
        height:500px;
        margin-left:15px;
        margin-right:15px;
        text-align: center;
        margin-top:20px;
      }
      #heading {
        padding-top: 150px;
        font-size: 150px;
        text-align:center;
        color:#0068FF;
        font-family: "Work Sans", sans-serif;
        font-optical-sizing:none;
        font-weight: 60px;
        font-style: normal;
      }
      #quote{
        margin-top: 5px;
        font-size: 40px;
        font-family:Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;
        color:white;
      }

    
      .auth-buttons {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
        margin-right: 15px;
      }

      .auth-button {
        color: white;
        background-color: transparent;
        height: 40px;
        width: 90px;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        border: none;
        text-align: center;
        font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
        margin-left: 10px;
      }

      .auth-button::before {
        content: "";
        position: absolute;
        background: white;
        height: 40px;
        width: 90%;
        top: 40px;
        transition: all 0.25s ease-in-out;
        z-index: 0;
      }

      .auth-button:hover::before {
        top: 0;
      }

      .auth-link {
        color: white;
        z-index: 1;
        position: relative;
        text-decoration: none;
        font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
        font-size: 28px;
      }

      .auth-button:hover .auth-link {
        color: #000000;
      }

      
      .signup-container {
        position: relative;
        display: inline-block;
      }

      .dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 40px;
        background-color: rgb(202, 202, 202);
        width: 136px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        z-index: 100;
        overflow: hidden;
        animation: fadeIn 0.2s ease;
        margin-right: 3px;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .dropdown-menu.show {
        display: block;
      }

      .dropdown-item {
        padding: 16px;
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: background-color 0.2s;
      }

      .dropdown-item:hover {
        background-color: #f0f0f0;
      }

      .dropdown-item span {
        color: #333;
        font-size: 16px;
        font-weight: 500;
        font-family: Arial, sans-serif;
      }

      .dropdown-item i {
        margin-right: 12px;
        color: #0068FF;
        font-size: 18px;
      }

      
      .hi {
        margin-top: 3000px;
      }
      .second-quote-image{
        height:750px;
       margin-top:300px;
      display: flex;
      justify-content:space-between;
      }
      #second-quote{
        font-size: 45px;
        font-family:cursive;
        align-content:center;
        margin-top: 90px;
        margin-left: 70px;
        color:#0068FF;
        width:600px;
        height:400px;
        text-align: center;
        box-shadow:-6px 6px 10px white;
      }

      #image4:hover,#image3:hover{
        transform:scale(1.08);
      }

      .third-quote-image{
        height:750px;
        margin-top:100px;
      display: flex;
      justify-content:space-between;
      }
      .fourth-quote-image{
        margin-top:200px;
        height:750px;
      display: flex;
      justify-content: space-evenly;
      }
      #third-quote{
          margin-top:120px;
          margin-right:100px;
          padding-top: 80px;
        font-size: 50px;
        font-family:cursive;
         border:2px solid black;
         border-radius: 8px;
        color:#0068FF;
        width:600px;
        height:400px;
        text-align: center;
        box-shadow:6px 6px 10px white;
      }
      #fourth-quote{
        font-size: 45px;
        font-family:cursive;
        margin-top:100px;
        align-content:center;
        color:#0068FF;
        width:600px;
        height:400px;
        text-align: center;
        box-shadow:-6px 6px 10px white;
      }
      #image2,#image3,#image4{
        align-items:center;
        margin-left:15px;
      }

      #content,#second-quote-matter,#fourth-quote-matter{
        font-size:20px;
        color:white;
      }
      .About-us{
        margin-left:450px;
        height:400px;
        width:500px;
      }
      #about-us-h2{
        text-decoration: underline;
        padding-left: 0px;
        font-weight: 900;
      }
      #about-text{
        font-size: 20px;
        font-family:Arial, Helvetica, sans-serif;
      }
      .location,.call{
        margin-top: 0px;
        display:flex;
        width:400px;
      }
      #iiits{
        margin-top:0px;
        padding-bottom:25px;
        padding-left:25px;
      }
      #number{
        margin-top:0px;
        padding-left: 20px;
      }

      
      footer {
        margin-top: 100px;
        padding: 40px 0;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }

      .footer-content {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        max-width: 1200px;
        margin: 0 auto;
      }

      .footer-section {
        flex: 1;
        padding: 0 20px;
        min-width: 200px;
        margin-bottom: 20px;
      }

      .footer-section h3 {
        color: #0068FF;
        margin-bottom: 20px;
        font-family: 'Work Sans', sans-serif;
      }

      .footer-section ul {
        list-style: none;
        padding: 0;
      }

      .footer-section ul li {
        margin-bottom: 10px;
      }

      .footer-section ul li a {
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .footer-section ul li a:hover {
        color: #0068FF;
      }

      .social-icons {
        margin-top: 20px;
      }

      .social-icons a {
        display: inline-block;
        margin: 0 10px;
        font-size: 20px;
        transition: color 0.3s ease;
      }

      .social-icons a:hover {
        color: #0068FF;
      }

      .copyright {
        margin-top: 30px;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
      }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Tektur:wght@400..900&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body>
    
    <div id="particles-js"></div>

    
    <div class="auth-buttons">
      <button class="auth-button">
        <a href="/login" class="auth-link">Login</a>
      </button>
      <div class="signup-container">
        <button class="auth-button" id="signupBtn">
          <span class="auth-link">Signup</span>
        </button>
        <div class="dropdown-menu" id="signupDropdown">
          <a href="/signup" class="dropdown-item">
            <span>As a Student</span>
          </a>
          <hr>
          <a href="/signupforrec" class="dropdown-item">
            <span>As a Recruiter</span>
          </a>
        </div>
      </div>
    </div>

    <div class="Relabteams">
      <div id="heading">RELABTeams</div>
      <div id="quote">"Creative minds unite through collaboration"</div>
    </div>
    <span class="second-quote-image">
      <span id="second-quote">NO MORE CONFUSION
        <p id="second-quote-matter">
        We streamline the Q&A Process. Begin your online Tutoring Journey by
        explaining the subjects you are passionate about.
        Grow with us on the fastest growing Q&A Solving platform.
        Our job is to make your knowledge worth its money. Clear your confusion by asking your doubts. Keep Learning!
        </p>
      </span>
      <span id="image2">
      <script src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs" type="module"></script>
        <dotlottie-player src="https://lottie.host/65a72fce-30a7-41ae-94d9-9afe87c64ffa/eGMdONNZao.lottie" background="transparent" speed="1" style="width: 600px; height: 600px" loop autoplay></dotlottie-player>
      </span>
    </span>
    <span class="third-quote-image">
      <span id="image3">
      <script src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs" type="module"></script>
      <dotlottie-player src="https://lottie.host/b86edbc5-7131-4b58-bdf4-9ebd32e25931/muvIOkqSg1.lottie" background="transparent" speed="1" style="width: 700px; height: 500px" loop autoplay></dotlottie-player>
      </span>
      <span id="third-quote">
        COLLAB AND WORK<br>
        <p id="content">With Relabteams you can work on projects that can help you build your resume
          and secure your dream job. Share your own creative project ideas on topics like web development, machine learning and more and start working on it.
         Collaboration is now made easier by relabteams.
        </p>
      </span>
    </span>
    <span class="fourth-quote-image">
      <span id="fourth-quote">
        HIRE YOUR FAVOURITE PROFILES
        <p id="fourth-quote-matter">
         Wanna hire people for your projects?
         No worries!! Relabteams helps you to hire your favourite profiles
         to work on your projects. Let others who are willing to build their resume finish your work quickly
         and get paid for their work.
        </p>
      </span>
      <span id="image4">
      <script src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs" type="module"></script>
      <dotlottie-player src="https://lottie.host/e694da30-e5b7-43ef-903a-5d57a3494a26/ZnJwYWFDbF.lottie" background="transparent" speed="1" style="width: 600px; height: 600px" loop autoplay></dotlottie-player>
      </span>
    </span>

    <!-- Go to Top Button -->
    <button id="topBtn" onclick="scrollToTop()">Go to Top</button>

    <div class="About-us">
      <h2 id="about-us-h2">About us</h2>
      <p id="about-text">RELABTeams is a collaborative community that helps
        in skill development and clarity over a particular topic.
         Together, Let's Create Something Extraordinary.
           Join RELABTeams and stand out in the crowd.</p>
      <div class="location">
        <i class="fa-solid fa-location-dot fa-xl" style="color: white;"></i>
         <h2 id="iiits">IIIT Sricity</h2>
        </div>
      <div class="call">
        <i class="fa-solid fa-phone fa-xl"></i>
        <h2 id="number">+91 7013538491</h2>
      </div>
    </div>

    <!-- Particles.js script -->
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    <script>
      
      let topBtn = document.getElementById("topBtn");

      
      window.onscroll = function () {
          if (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) {
              topBtn.style.display = "block";
          } else {
              topBtn.style.display = "none";
          }
      };

      // Scroll to top function
      function scrollToTop() {
          document.body.scrollTop = 0; 
          document.documentElement.scrollTop = 0; 
      }

      
      const signupBtn = document.getElementById("signupBtn");
      const signupDropdown = document.getElementById("signupDropdown");

      signupBtn.addEventListener("mouseover", function() {
          signupDropdown.classList.add("show");
          signupBtn.classList.add("hover");
      });

      signupBtn.addEventListener("mouseout", function() {
          signupDropdown.classList.remove("show");
          signupBtn.classList.remove("hover");
      });

      signupDropdown.addEventListener("mouseover", function() {
          signupDropdown.classList.add("show");
          signupBtn.classList.add("hover");
      });

      signupDropdown.addEventListener("mouseout", function() {
          signupDropdown.classList.remove("show");
          signupBtn.classList.remove("hover");
      });

      // Close dropdown when clicking outside
      window.onclick = function(event) {
          if (!event.target.matches('#signupBtn') && !event.target.matches('.auth-link')) {
              var dropdowns = document.getElementsByClassName("dropdown-menu");
              for (var i = 0; i < dropdowns.length; i++) {
                  var openDropdown = dropdowns[i];
                  if (openDropdown.classList.contains('show')) {
                      openDropdown.classList.remove('show');
                  }
              }
              signupBtn.classList.remove("hover");
          }
      }

      // Initialize particles.js
      document.addEventListener('DOMContentLoaded', function() {
          if (window.particlesJS) {
              particlesJS('particles-js', {
                  "particles": {
                      "number": {
                          "value": 200,
                          "density": {
                              "enable": true,
                              "value_area": 1000
                          }
                      },
                      "color": {
                          "value": "#0068FF"
                      },
                      "shape": {
                          "type": "circle",
                          "stroke": {
                              "width": 0,
                              "color": "#000000"
                          }
                      },
                      "opacity": {
                          "value": 1,
                          "random": false
                      },
                      "size": {
                          "value": 3,
                          "random": true
                      },
                      "line_linked": {
                          "enable": true,
                          "distance": 150,
                          "color": "#0068FF",
                          "opacity": 0.4,
                          "width": 1
                      },
                      "move": {
                          "enable": true,
                          "speed": 2,
                          "direction": "none",
                          "random": false,
                          "straight": false,
                          "out_mode": "out",
                          "bounce": false
                      }
                  },
                  "interactivity": {
                      "detect_on": "window",
                      "events": {
                          "onhover": {
                              "enable": true,
                              "mode": "repulse"
                          },
                          "onclick": {
                              "enable": true,
                              "mode": "push"
                          },
                          "resize": true
                      },
                      "modes": {
                          "repulse": {
                              "distance": 100,
                              "duration": 0.4
                          },
                          "push": {
                              "particles_nb": 4
                          }
                      }
                  },
                  "retina_detect": true
              });
          } else {
              console.error("Particles.js is not loaded properly");
          }
      });

      // Alternative initialization with a small delay to ensure proper loading
      setTimeout(function() {
          if (window.particlesJS && document.getElementById('particles-js')) {
              if (typeof particlesJS.load === 'function') {
                  particlesJS.load('particles-js', {
                    
                  });
              }
          }
      }, 1000);
    </script>
  </body>
</html>