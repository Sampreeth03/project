<!-- views/project.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RELABTeams - <%= project.title %></title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }

    body {
      background-color: #111111;
      color: white;
      padding-top: 10vh;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 60px;
      background-color: black;
      padding: 15px 5%;
      display: flex;
      z-index: 1000;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 30px;
      color: #0068FF;
      font-weight: bold;
      margin-right: 30px;
    }

    #logo-link {
      text-decoration: none;
      color: #0068FF;
    }

    .nav-links {
      list-style: none;
      display: flex;
      gap: 38px;
      position: relative;
    }

    .nav-links li {
      position: relative;
    }

    .nav-links li a {
      color: white;
      text-decoration: none;
      font-size: 20px;
      transition: color 0.3s ease;
      padding: 10px;
      display: block;
    }

    .nav-links li a:hover {
      color: #0068FF;
    }

    .dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background-color: black;
      min-width: max-content;
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
      z-index: 1000;
    }

    .dropdown li {
      width: 100%;
    }

    .dropdown li a {
      padding: 12px;
      font-size: 18px;
      display: block;
      color: white;
      white-space: nowrap;
    }

    .dropdown li a:hover {
      background-color: #333;
      color: #0068FF;
    }

    .nav-links li:hover .dropdown {
      display: block;
    }

    .search-box {
      padding: 8px;
      border-radius: 5px;
      border: none;
      outline: none;
      width: 205px;
      background-color: #222;
      color: white;
    }

    .container {
      max-width: 1200px;
      margin: 24px auto;
      padding: 0 16px;
    }

    .project-header {
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .project-title {
      font-size: 28px;
      color: white;
    }

    .project-nav {
      position: relative;
      display: inline-block;
    }

    .project-dropdown-btn {
      background-color: #333333;
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 4px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .project-dropdown-content {
      display: none;
      position: absolute;
      right: 0;
      background-color: #222222;
      min-width: 200px;
      box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.5);
      z-index: 1;
      border-radius: 4px;
      overflow: hidden;
    }

    .project-dropdown-content a {
      color: white;
      padding: 12px 16px;
      text-decoration: none;
      display: block;
      transition: background-color 0.2s;
    }

    .project-dropdown-content a:hover {
      background-color: #333333;
    }

    .project-nav:hover .project-dropdown-content {
      display: block;
    }

    .tasks-container {
      background-color: #222222;
      border-radius: 8px;
      box-shadow: 0 1px 3px rgba(255, 255, 255, 0.1);
      padding: 24px;
      margin-bottom: 24px;
    }

    .tasks-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .new-task-btn {
      background-color: #0068FF;
      color: white;
      border: none;
      border-radius: 4px;
      padding: 8px 16px;
      font-weight: 500;
      cursor: pointer;
    }

    .task-card {
      border: 1px solid #333333;
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 16px;
      background-color: #1A1A1A;
    }

    .task-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .task-title {
      font-size: 18px;
      font-weight: 600;
      color: white;
      margin-bottom: 8px;
    }

    .task-meta {
      display: flex;
      justify-content: space-between;
      margin-bottom: 16px;
      color: #BBBBBB;
      font-size: 14px;
    }

    .task-description {
      margin-bottom: 16px;
      line-height: 1.5;
      color: #DDDDDD;
    }

    .task-link {
      margin-bottom: 16px;
      display: block;
      color: #0068FF;
    }

    .task-actions {
      display: flex;
      gap: 8px;
    }

    .task-btn {
      padding: 6px 12px;
      border-radius: 4px;
      font-size: 14px;
      cursor: pointer;
      border: none;
    }

    .status-label {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 500;
    }

    .completed {
      background-color: #143C21;
      color: #66BB6A;
    }

    .in-progress {
      background-color: #3D3000;
      color: #FFC107;
    }

    .review {
      background-color: #202639;
      color: #90CAF9;
    }

    .assigned {
      background-color: #002447;
      color: #0068FF;
    }

    .check-status-btn {
      background-color: #333333;
      color: white;
      border: 1px solid #444444;
    }
    .task-feedback {
    margin-top: 10px;
    font-size: 14px;
    color: #333;
}

.accept-btn {
    background-color: #28a745;
    color: white;
    border: none;
    padding: 6px 12px;
    margin: 5px;
    cursor: pointer;
    border-radius: 4px;
}

.accept-btn:hover {
    background-color: #218838;
}

.reject-btn {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 6px 12px;
    margin: 5px;
    cursor: pointer;
    border-radius: 4px;
}

.reject-btn:hover {
    background-color: #c82333;
}

