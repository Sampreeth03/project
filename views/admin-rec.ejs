<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RELABTeams Recruiters</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Keeping all original styles, just removing unnecessary modal styles */
        :root {
            --primary: #0068FF;
            --secondary: #0056d6;
            --dark: #121212;
            --darker: #0a0a0a;
            --light-text: #ffffff;
            --gray-text: #a0a0a0;
            --gray-dark: #2a2a2a;
            --success: #4ade80;
            --danger: #ef4444;
            --warning: #f59e0b;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: var(--dark);
            color: var(--light-text);
        }
        
        .container {
            display: flex;
            min-height: 100vh;
        }
        
        .sidebar {
            width: 280px;
            background-color: var(--darker);
            color: var(--light-text);
            padding: 20px 0;
            height: 100vh;
            position: fixed;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 100;
        }
        
        .sidebar-header {
            padding: 0 25px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }
        
        .logo {
            display: flex;
            align-items: center;
            color: var(--light-text);
            text-decoration: none;
        }
        
        .logo img {
            height: 40px;
            margin-right: 10px;
        }
        
        .logo-text {
            font-size: 22px;
            font-weight: 700;
            color: #0068FF;
        }
        
        .nav-menu {
            padding: 10px 0;
        }
        
        .menu-label {
            padding: 0 25px;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--gray-text);
            margin-bottom: 10px;
            margin-top: 20px;
        }
        
        .menu-item {
            padding: 12px 25px;
            display: flex;
            align-items: center;
            color: var(--gray-text);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }
        
        .menu-item:hover {
            color: var(--light-text);
            background-color: rgba(255, 255, 255, 0.05);
        }
        
        .menu-item.active {
            color: var(--light-text);
            background-color: rgba(0, 104, 255, 0.1);
            border-left: 4px solid var(--primary);
        }
        
        .menu-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            font-size: 18px;
        }
        
        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 30px;
            transition: all 0.3s;
            overflow-x: hidden;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        
        .page-title h2 {
            font-weight: 600;
            margin-bottom: 5px;
        }
        
        .page-title h4 {
            color: var(--gray-text);
            font-weight: normal;
        }
        
        .admin-controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        .search-box {
            position: relative;
            width: 300px;
        }
        
        .search-box input {
            width: 100%;
            padding: 10px 40px 10px 15px;
            border-radius: 8px;
            border: 1px solid var(--gray-dark);
            background-color: var(--darker);
            color: var(--light-text);
            outline: none;
        }
        
        .search-box input::placeholder {
            color: var(--gray-text);
        }
        
        .search-box i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-text);
        }
        
        .admin-profile {
            display: flex;
            align-items: center;
            cursor: pointer;
        }
        
        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }
        
        .admin-info {
            display: flex;
            flex-direction: column;
        }
        
        .admin-name {
            font-weight: 500;
        }
        
        .admin-role {
            font-size: 12px;
            color: var(--gray-text);
        }
        
        .recruiter-filters {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .filter-item {
            padding: 8px 16px;
            background-color: var(--darker);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .filter-item.active {
            background-color: var(--primary);
        }
        
        .filter-item:hover {
            background-color: var(--gray-dark);
        }
        
        .recruiters-table {
            width: 100%;
            border-collapse: collapse;
            background-color: var(--darker);
            border-radius: 10px;
            overflow: hidden;
        }
        
        .recruiters-table th, 
        .recruiters-table td {
            padding: 15px 20px;
            text-align: left;
        }
        
        .recruiters-table th {
            background-color: rgba(0, 0, 0, 0.2);
            font-weight: 500;
            color: var(--gray-text);
        }
        
        .recruiters-table tr {
            border-bottom: 1px solid var(--gray-dark);
        }
        
        .recruiters-table tr:last-child {
            border-bottom: none;
        }
        
        .recruiters-table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
        
        
        .page-btn {
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--darker);
            color: var(--gray-text);
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .page-btn:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: var(--light-text);
        }
        
        .page-btn.active {
            background-color: var(--primary);
            color: var(--light-text);
        }
        
        .company-logo {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--dark);
            margin-right: 10px;
            font-weight: bold;
            color: var(--light-text);
        }
        
        .recruiter-info {
            display: flex;
            align-items: center;
        }
        
        .recruiter-name {
            font-weight: 500;
        }
        
        .recruiter-company {
            font-size: 12px;
            color: var(--gray-text);
        }
        
        .recruitment-count {
            font-weight: 600;
            color: var(--light-text);
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <div class="header">
                <div class="page-title">
                    <h2>Recruiters</h2>
                    <h4>Manage CSE department recruiters and their accounts</h4>
                </div>
                <div class="admin-controls">
                    <div class="search-box">
                        <input type="text" placeholder="Search recruiters..." id="searchRecruiter">
                        <i class="fas fa-search"></i>
                    </div>
                    
                    <div class="admin-profile">
                        <div class="admin-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="admin-info">
                            <div class="admin-name"><%= adminName %></div>
                            <div class="admin-role">Super Admin</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recruiters Table -->
<table class="recruiters-table">
    <thead>
        <tr>
            <th>Recruiter</th>
            <th>Email</th>
            <th>CSE Role</th>
            <th>Recruitments</th>
            <th>Joined Date</th>
        </tr>
    </thead>
    <tbody id="recruitersTableBody">
    </tbody>
</table>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
    // Store initial data from server
    const recruiters = <%- JSON.stringify(recruitersData) %>;

    console.log('Recruiters data:', recruiters); // Debug log to check received data

    // DOM elements
    const recruitersTableBody = document.getElementById('recruitersTableBody');
    const searchInput = document.getElementById('searchRecruiter');

    // Load recruiters data
    function loadRecruiters(searchTerm = '') {
        recruitersTableBody.innerHTML = '';
        
        let filteredRecruiters = recruiters;
        
        if (searchTerm) {
            const term = searchTerm.toLowerCase();
            filteredRecruiters = recruiters.filter(recruiter => 
                (recruiter.name && recruiter.name.toLowerCase().includes(term)) || 
                (recruiter.email && recruiter.email.toLowerCase().includes(term)) || 
                (recruiter.company && recruiter.company.toLowerCase().includes(term))
            );
        }
        
        filteredRecruiters.forEach(recruiter => {
            const row = document.createElement('tr');
            
            // Handle joinDate safely
            const joinDate = recruiter.joinedDate && !isNaN(new Date(recruiter.joinedDate).getTime())
                ? new Date(recruiter.joinedDate)
                : new Date();
            const formattedDate = joinDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
            
            const companyInitial = recruiter.company && recruiter.company.length > 0 
                ? recruiter.company.charAt(0) 
                : 'N/A';
            
            row.innerHTML = `
                <td>
                    <div class="recruiter-info">
                        <div class="company-logo">${companyInitial}</div>
                        <div>
                            <div class="recruiter-name">${recruiter.name}</div>
                            <div class="recruiter-company">${recruiter.company}</div>
                        </div>
                    </div>
                </td>
                <td>${recruiter.email || 'N/A'}</td>
                <td>${recruiter.role || 'Recruiter'}</td>
                <td>
                    <div class="recruitment-count">${recruiter.recruitmentCount || 0}</div>
                </td>
                <td>${formattedDate}</td>
            `;
            
            recruitersTableBody.appendChild(row);
        });
    }

    // Search recruiters
    searchInput.addEventListener('input', function() {
        loadRecruiters(this.value);
    });

    // Load recruiters on page load
    loadRecruiters();
});
    </script>
</body>
</html>