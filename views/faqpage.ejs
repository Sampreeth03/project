<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FAQ Section with Popup</title>

    <style>
      body {
        font-family: "Poppins", sans-serif;
        background-color: #121212;
        color: white;
        margin: 0;
        padding: 0;
        text-align: center;
      }

     
.navbar { position: fixed; top: 0; left: 0; width: 100%; height: 60px; background-color: black; padding: 15px 5%; display: flex; z-index: 1000; align-items: center; justify-content: space-between; }
        .logo { font-size: 30px; color: #0068FF; font-weight: bold; margin-right: 30px; }
        #logo-link { text-decoration: none; color: #0068FF; }
        .nav-links { list-style: none; display: flex; gap: 38px; position: relative; }
        .nav-links li { position: relative; }
        .nav-links li a { color: white; text-decoration: none; font-size: 20px; transition: color 0.3s ease; padding: 10px; display: block; }
        .nav-links li a:hover { color: #0068FF; }
        .dropdown { display: none; position: absolute; top: 100%; left: 0; background-color: black; min-width: max-content; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2); z-index: 1000; }
        .dropdown li { width: 100%; }
        .dropdown li a { padding: 12px; font-size: 18px; display: block; color: white; white-space: nowrap; }
        .dropdown li a:hover { background-color: #333; color: #0068FF; }
        .nav-links li:hover .dropdown { display: block; }
        .search-box { padding: 8px; border-radius: 5px; border: none; outline: none; width: 205px; background-color: #222; color: white; }



      .faq-container {
        max-width: 800px;
        margin: 5px auto;
        padding: 20px;
        background: #1e1e1e;
      }

      h2 {
        font-size: 36px;
        color: #ffffff;
        height: 90px;
        padding-top: 100px;
      }

      .faq-item {
        border-bottom: 1px solid #444;
        padding: 15px 0;
      }

      .faq-question {
        background: none;
        border: none;
        color: white;
        font-size: 20px;
        width: 100%;
        text-align: left;
        padding: 15px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease-in-out;
        font-weight: bold;
      }

      .faq-question:hover {
        color: #3647dc;
        transform: translateX(5px);
      }

      .arrow {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-left: 2px solid white;
        border-bottom: 2px solid white;
        transform: rotate(-45deg);
        transition: transform 0.3s ease-in-out;
        margin-left: 10px;
      }

      .rotate-down {
        transform: rotate(135deg);
      }

      .faq-answer {
        display: none;
        padding: 10px 15px;
        color: #bbb;
        text-align: left;
        line-height: 1.6;
      }

      .contact-section {
        background-color: blue;
        padding: 40px;
        margin-top: 40px;
        border-radius: 10px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        color: white;
        text-align: center;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
      }

      .contact-section h3 {
        font-size: 24px;
      }

      .contact-button {
        background-color: #facc15;
        color: #222;
        padding: 12px 25px;
        font-size: 18px;
        border: none;
        cursor: pointer;
        border-radius: 5px;
        transition: 0.3s;
        margin-top: 15px;
        font-weight: bold;
        box-shadow: 0px 4px 8px rgba(255, 204, 0, 0.3);
      }

      .contact-button:hover {
        background-color: #ebc941;
      }

      .modal {
        display: none;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        align-items: center;
        justify-content: center;
      }

      .modal-content {
        background: #1e1e1e;
        padding: 30px;
        border-radius: 10px;
        text-align: center;
        max-width: 400px;
        position: relative;
        animation: fadeIn 0.3s ease-in-out;
      }

      .modal-content p {
        font-size: 18px;
        color: #ddd;
      }

      .modal-content a {
        color: #ff4c4c;
        font-weight: bold;
        text-decoration: none;
      }

      .modal-content a:hover {
        text-decoration: underline;
      }

      .close-btn {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 24px;
        cursor: pointer;
        color: white;
      }

      .close-btn:hover {
        color: #ff4c4c;
      }
      .show-answer {
        display: block;
      }

      @media (max-width: 768px) {
        .faq-container {
          width: 90%;
        }
      }
    </style>
  </head>
  <body>
    
    <header>
      <div class="navbar">
          <span class="logo"><a id="logo-link" href="<%= homeUrl %>">RELABTeams</a></span>
          <ul class="nav-links">
              <% navLinks.forEach(link => { %>
                  <li>
                      <a href="<%= link.href %>"><%= link.name %></a>
                      <% if (link.submenu) { %>
                          <ul class="dropdown">
                              <% link.submenu.forEach(sublink => { %>
                                  <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                              <% }) %>
                          </ul>
                      <% } %>
                  </li>
              <% }) %>
          </ul>
          <input type="text" placeholder="Search" class="search-box">
      </div>
  </header>
    <div>
      <h2>Frequently Asked Questions</h2>
    </div>

    <div class="faq-container">
      <div class="faq-item">
        <button class="faq-question">
          What is RELABTeams?<span class="arrow"></span>
        </button>
        <div class="faq-answer">
          RELABTeams is a professional networking and career development
          platform that connects job seekers, recruiters, and industry
          professionals. It helps users build their network, find job
          opportunities, and grow their careers.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          How does RELABTeams help professionals and companies?
          <span class="arrow"></span>
        </button>
        <div class="faq-answer">
          We help professionals connect, learn, and grow by providing: Job
          listings and career opportunities A space to network with industry
          leaders Skill development resources A platform for companies to find
          top talent
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          Who can use RELABTeams?
          <span class="arrow"></span>
        </button>
        <div class="faq-answer">
          Anyone looking to grow professionally! Whether you’re a job seeker,
          recruiter, freelancer, or industry expert, there’s something here for
          you.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          What makes RELABTeams different from other job and networking
          platforms?
          <span class="arrow"></span>
        </button>
        <div class="faq-answer">
          Great question! We’re not just another job board—we’re a career growth
          hub. Here’s what sets us apart:
          <ul>
            <li>job matching for tailored recommendations</li>
            <li>
              Smart networking to connect you with like-minded professionals
            </li>
            <li>
              Industry insights, courses, and expert content to level up your
              career
            </li>
          </ul>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          Can I apply for jobs with one click?<span class="arrow"></span>
        </button>
        <div class="faq-answer">
          Yes! If you upload your resume and complete your profile, you can use
          our “Apply” button. No more filling out endless forms!
        </div>
      </div>
    </div>

    <div class="contact-section">
      <h3>Still have questions?</h3>
      <p>
        Can’t find the answer you’re looking for? Please chat with our friendly
        team.
      </p>
      <button class="contact-button" id="openModal">Contact Us</button>
    </div>

    <div class="modal" id="contactModal">
      <div class="modal-content">
        <span class="close-btn" id="closeModal">&times;</span>
        <img
          src="https://cdn-icons-png.flaticon.com/512/2910/2910795.png"
          width="60"
          alt="Contact Icon"
        />
        <p><strong>Drop your question/query at</strong></p>
        <p><a href="#">contact@relabteams.org</a></p>
        <p>We will get back to you soon.</p>
      </div>
    </div>

    <script>
      document.querySelectorAll(".faq-question").forEach((question) => {
        question.addEventListener("click", function () {
          this.nextElementSibling.classList.toggle("show-answer");
          this.querySelector(".arrow").classList.toggle("rotate-down");
        });
      });
      const modal = document.getElementById("contactModal");
      document.getElementById("openModal").onclick = () =>
        (modal.style.display = "flex");
      document.getElementById("closeModal").onclick = () =>
        (modal.style.display = "none");

      window.onclick = (e) => {
        if (e.target === modal) modal.style.display = "none";
      };
    </script>
  </body>
</html>
