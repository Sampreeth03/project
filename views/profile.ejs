        <div class="profile-details">
            <div class="details-container">
                <h3>About Me:</h3>
                <p style="font-size: 20px; color: rgb(195, 191, 191);">👾Hey there! I'm a passionate Data Science enthusiast with a strong commitment to learning and growth. As an academically inclined second-year B.Tech. student at the Indian Institute of Information Technology (IIIT), Sri City specializing in Data Science. I'm on a journey to explore the intersection of technology, data, visualization, and innovation.
                    📈 My professional journey has been marked by invaluable experiences, including being a Power BI Head Intern @CLUMOSS, PR Lead @GDSC IIIT Sri City and Game development lead @IOTA. These roles have allowed me to immerse myself in the world of technology and gain hands-on experience with cutting-edge solutions.
                    📚 My certifications speak to my dedication and expertise in the field of data science. </p>
            </div>
            <div class="details-container">
                <h3>Skills:</h3>
                <div class="skills">
                    <span class="skill">HTML</span>
                    <span class="skill">CSS</span>
                    <span class="skill">JavaScript</span>
                    <span class="skill">Python</span>
                    <span class="skill">React</span>
                </div>
            </div>
            <div class="details-container">
                <h3>Interested In:</h3>
                <div class="interests">
                    <span class="interest">Web Development</span>
                    <span class="interest">Machine Learning</span>
                    <span class="interest">Cloud Computing</span>
                    <span class="interest">Generative AI</span>
                </div>
            </div><br><br>
            <hr>
            <h3 style="color: rgb(255, 255, 255); font-size: 30px;">Resume:</h3>
            <div class="resume-container">
                <button class="noselect" onclick="document.getElementById('directResume').click()">
                    <h4 style=" margin-left: 35%; font-size: 20px;"><span class="text">Add</span></h4>
                    <span class="icon">
                        <svg viewBox="0 0 24 24" height="24" width="24" xmlns="http://www.w3.org/2000/svg">
                        </svg>
                        <span class="buttonSpan">+</span>
                    </span>
                </button>
                <iframe id="resumeFrame" src=""></iframe>
                <input type="file" id="directResume" accept=".pdf" style="display:none;" onchange="loadResume(event)">
            </div>
        </div>
        <div class="edit-mode" id="editMode">
            <div class="edit-mode-content">
                <label for="editName">Name:</label>
                <input type="text" id="editName" placeholder="Name">
                <label for="editEmail">Email:</label>
                <input type="email" id="editEmail" placeholder="Email">
                <label for="editAbout">About Me:</label>
                <textarea id="editAbout" placeholder="About Me"></textarea>
                <label for="editSkills">Skills:</label>
                <input type="text" id="editSkills" placeholder="Skills">
                <label for="editInterests">Interests:</label>
                <input type="text" id="editInterests" placeholder="Interests">
                <label for="editProfilePic">Profile Picture:</label>
                <input type="file" id="editProfilePic" accept="image/*">
                <label for="editResume">Resume:</label>
                <input type="file" id="editResume" accept=".pdf">
                <div class="but-cont">
                    <button onclick="saveChanges()">Save</button><br>
                    <button onclick="cancelEdit()">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        function loadImage(event) {
            const profileImage = document.getElementById("profileImage");
            const profilePic = document.getElementById("profilePic");
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    profileImage.src = e.target.result;
                    profileImage.style.display = "block";
                    profilePic.style.backgroundColor = "transparent";
                    document.querySelector('.plusButton').style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        }
        function loadResume(event) {
            const resumeFrame = document.getElementById("resumeFrame");
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    resumeFrame.src = e.target.result;
                    document.querySelector('.noselect').style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        }
        function toggleEditMode() {
            const editMode = document.getElementById("editMode");
            editMode.classList.toggle("active");
            if (editMode.classList.contains("active")) {
                document.getElementById("editName").value = "Eswar babu Ettaligalla";
                document.getElementById("editEmail").value = "eswar.e1433@gmail.com";
                document.getElementById("editAbout").value = "👾Hey there! I'm a passionate Data Science enthusiast with a strong commitment to learning and growth. As an academically inclined second-year B.Tech. student at the Indian Institute of Information Technology (IIIT), Sri City specializing in Data Science. I'm on a journey to explore the intersection of technology, data, visualization, and innovation.📈 My professional journey has been marked by invaluable experiences, including being a Power BI Head Intern @CLUMOSS, PR Lead @GDSC IIIT Sri City and Game development lead @IOTA. These roles have allowed me to immerse myself in the world of technology and gain hands-on experience with cutting-edge solutions. My certifications speak to my dedication and expertise in the field of data science.";
                document.getElementById("editSkills").value = "HTML, CSS, JavaScript, Python, React";
                document.getElementById("editInterests").value = "Web Development, Machine Learning, Cloud Computing, Generative AI";
            }
        }
        function saveChanges() {
            const name = document.getElementById("editName").value;
            const email = document.getElementById("editEmail").value;
            const about = document.getElementById("editAbout").value;
            const skills = document.getElementById("editSkills").value.split(",").map(skill => skill.trim());
            const interests = document.getElementById("editInterests").value.split(",").map(interest => interest.trim());
            const resumeFile = document.getElementById("editResume").files[0];
            const profilePicFile = document.getElementById("editProfilePic").files[0];
            document.querySelector(".profile-info h2").textContent = name;
            document.querySelector(".profile-info p").textContent = "Email: " + email;
            document.querySelector(".details-container p").textContent = about;
            const skillsContainer = document.querySelector(".skills");
            skillsContainer.innerHTML = "";
            skills.forEach(skill => {
                const skillElement = document.createElement("span");
                skillElement.classList.add("skill");
                skillElement.textContent = skill;
                skillsContainer.appendChild(skillElement);
            });
            const interestsContainer = document.querySelector(".interests");
            interestsContainer.innerHTML = "";
            interests.forEach(interest => {
                const interestElement = document.createElement("span");
                interestElement.classList.add("interest");
                interestElement.textContent = interest;
                interestsContainer.appendChild(interestElement);
            });
            if (resumeFile) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById("resumeFrame").src = e.target.result;
                    document.querySelector('.noselect').style.display = 'none';
                };
                reader.readAsDataURL(resumeFile);
            }
            if (profilePicFile) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById("profileImage").src = e.target.result;
                    document.getElementById("profileImage").style.display = "block";
                    document.getElementById("profilePic").style.backgroundColor = "transparent";
                    document.querySelector('.plusButton').style.display = 'none';
                };
                reader.readAsDataURL(profilePicFile);
            }
            document.getElementById("editMode").classList.remove("active");
        }
        function cancelEdit() {
            document.getElementById("editMode").classList.remove("active");
        }
        document.getElementById("editProfilePic").addEventListener("change", loadImage);
        document.getElementById("editResume").addEventListener("change", loadResume);
    </script>
</body>
</html>