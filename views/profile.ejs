<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <style>
        .navbar { position: fixed; top: 0; left: 0; width: 100%; height: 45px; background-color: black; padding: 15px 5%; display: flex; z-index: 1000; align-items: center; justify-content: space-between; }
        .logo { font-size: 30px; color: #0068FF; font-weight: bold; margin-right: 30px; }
        #logo-link { text-decoration: none; color: #0068FF; }
        .nav-links { list-style: none; display: flex; gap: 38px; position: relative; }
        .nav-links li { position: relative; }
        .nav-links li a { color: white; text-decoration: none; font-size: 20px; transition: color 0.3s ease; padding: 10px; display: block; }
        .nav-links li a:hover { color: #0068FF; }
        .dropdown { display: none; position: absolute; top: 100%; left: 0; background-color: black; min-width: max-content; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2); z-index: 1000; }
        .dropdown li { width: 100%; }
        .dropdown li a { padding: 12px; font-size: 18px; display: block; color: white; white-space: nowrap; }
        .dropdown li a:hover { background-color: #333; color: #0068FF; }
        .nav-links li:hover .dropdown { display: block; }
        .search-box { padding: 8px; border-radius: 5px; border: none; outline: none; width: 205px; background-color: #222; color: white; }
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: flex;
            background-color: #000000;
            margin: 0;
            padding: 0;
            margin-top: 75px;
        }
        .profile-container {
            background: rgb(45, 45, 45);
            padding: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 1450px;
            position: relative;
        }
        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .profile-pic {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 2px solid #0068FF;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .profile-pic img {
            width: 100%;
            height: 100%;
            display: none;
        }
        .profile-pic .plusButton {
            display: flex;
            justify-content: center;
            align-items: center;
            position: absolute;
        }
        .profile-pic .plusButton svg {
            width: 50px;
            height: 50px;
        }
        .profile-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .profile-info h2 {
            margin: 10px 50px;
            color: #ffffff;
            font-size: 45px;
            text-align: center;
            justify-content: center;
        }
        .profile-info p {
            color: #ffffff;
            font-size: 25px;
            text-align: center;
            justify-content: center;
        }
        .details-container {
            text-align: left;
            margin-top: 20px;
        }
        .details-container h3 {
            color: #ffffff;
            margin-bottom: 5px;
            font-size: 30px;
        }
        .skills, .interests {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }
        .skill, .interest {
            background: #0068FF;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 20px;
        }
        .resume-container {
            margin-top: 20px;
            position: relative;
        }
        .resume-container iframe {
            width: 100%;
            height: 250px;
            border: 1px solid #ddd;
            margin-top: 10px; 
        }
        .edit-button {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: rgb(20, 20, 20);
            border: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.164);
            cursor: pointer;
            transition-duration: 0.3s;
            overflow: hidden;
            position: absolute;
            top: 10px;
            right: 10px;
            text-decoration: none !important;
        }
        .edit-svgIcon {
            width: 17px;
            transition-duration: 0.3s;
        }
        .edit-svgIcon path {
            fill: white;
        }
        .edit-button::before {
            display: none;
            content: "Edit";
            color: white;
            transition-duration: 0.3s;
            font-size: 20px;
        }
        .edit-button:hover::before {
            display: block;
            font-size: 15px;
        }
        .edit-mode {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 10;
            display: flex;
            justify-content: center;
            align-items: center;
            display: none;
        }
        .edit-mode.active {
            display: flex;
        }
        .edit-mode-content {
            background: white;
            padding: 60px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            width: 500px;
            text-align: center;
            max-height: 90%;
            overflow-y: auto;
        }
        .edit-mode label {
            width: 100%;
            text-align: left;
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 20px;
        }
        .edit-mode input, .edit-mode textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 20px;
        }
        .edit-mode button {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            background-color: #0073b1;
            color: white;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-top: 10px;
        }
        .edit-mode button:hover {
            background-color: #005bb5;
        }
        .but-cont {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
         gap: 10px;
        }
        .but-cont button:hover{
            color: #ffc01d;
        }
        ul {
            list-style: none;
        }
        .example {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 20px;
            gap: 20px; /* Add this line to create space between icons */
        }
        .example .icon-content {
            margin: 0; /* Remove margin to use gap instead */
            position: relative;
        }
        .example .icon-content .tooltip {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            color: #fff;
            padding: 6px 10px;
            border-radius: 5px;
            opacity: 0;
            visibility: hidden;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        .example .icon-content:hover .tooltip {
            opacity: 1;
            visibility: visible;
            top: -50px;
        }
        .example .icon-content a {
            position: relative;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            color: #4d4d4d;
            background-color: rgb(45, 45, 45);
            transition: all 0.3s ease-in-out;
        }
        .example .icon-content a:hover {
            box-shadow: 3px 2px 45px 0px rgb(45, 45, 45)
        }
        .example .icon-content a svg {
            position: relative;
            z-index: 1;
            width: 30px;
            height: 30px;
        }
        .example .icon-content a:hover {
            color: white;
        }
        .example .icon-content a .filled {
            position: absolute;
            top: auto;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 0;
            background-color: #ffffff;
            transition: all 0.3s ease-in-out;
        }
        .example .icon-content a:hover .filled {
            height: 100%;
        }
        .plusButton {
            --plus_sideLength: 2.5rem;
            --plus_topRightTriangleSideLength: 0.9rem;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid white;
            width: var(--plus_sideLength);
            height: var(--plus_sideLength);
            background-color: #000000;
            overflow: hidden;
        }
        .plusButton::before {
            position: absolute;
            content: "";
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            border-width: 0 var(--plus_topRightTriangleSideLength) var(--plus_topRightTriangleSideLength) 0;
            border-style: solid;
            border-color: transparent white transparent transparent;
            transition-timing-function: ease-in-out;
            transition-duration: 0.2s;
        }
        .plusButton:hover {
            cursor: pointer;
        }
        .plusButton:hover::before {
            --plus_topRightTriangleSideLength: calc(var(--plus_sideLength) * 2);
        }
        .plusButton:focus-visible::before {
            --plus_topRightTriangleSideLength: calc(var(--plus_sideLength) * 2);
        }
        .plusButton > .plusIcon {
            fill: white;
            width: calc(var(--plus_sideLength) * 0.7);
            height: calc(var(--plus_sideLength) * 0.7);
            z-index: 1;
            transition-timing-function: ease-in-out;
            transition-duration: 0.2s;
        }
        .plusButton:hover > .plusIcon {
            fill: black;
            transform: rotate(180deg);
        }
        .plusButton:focus-visible > .plusIcon {
            fill: black;
            transform: rotate(180deg);
        }
        button {
            width: 150px;
            height: 50px;
            cursor: pointer;
            display: flex;
            align-items: center;
            background: #000000;
            border: none;
            border-radius: 5px;
            box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.15);
        }
        button,
        button span {
            transition: 200ms;
        }
        button .text {
            transform: translateX(35px);
            color: white;
            font-weight: bold;
        }
        button .icon {
            position: absolute;
            border-left: 1px solid #000000;
            transform: translateX(110px);
            height: 40px;
            width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        button svg {
            width: 15px;
            fill: #eee;
        }
        button:hover {
            background: #000000;
        }
        button:active {
            background: #000000;
        }
        button:hover .text {
            color: transparent;
        }
        button:hover .icon {
            width: 150px;
            border-left: none;
            transform: translateX(0);
        }
        button:focus {
            outline: none;
        }
        button:active .icon svg {
            transform: scale(0.8);
        }
        .buttonSpan {
            color: white;
            margin: 150px;
            font-size: 30px;
        }
        .feedback svg {
    vertical-align: middle;
    margin-right: 4px;
}
        .feedback {

            color: #ffffff;
            font-size: 20px;
            margin-left: 800px;
        }
        .feedback span {
            margin-right: 10px;
        }
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <span class="logo"><a id="logo-link" href="<%= homeUrl %>">RELABTeams</a></span>
            <ul class="nav-links">
                <% navLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>"><%= link.name %></a>
                        <% if (link.submenu) { %>
                            <ul class="dropdown">
                                <% link.submenu.forEach(sublink => { %>
                                    <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
            <input type="text" placeholder="Search" class="search-box">
        </div>
    </header>
    <div class="profile-container">
        <button class="edit-button" onclick="toggleEditMode()">
            <svg class="edit-svgIcon" viewBox="0 0 512 512">
                <path d="M410.3 231l11.3-11.3-33.9-33.9-62.1-62.1L291.7 89.8l-11.3 11.3-22.6 22.6L58.6 322.9c-10.4 10.4-18 23.3-22.2 37.4L1 480.7c-2.5 8.4-.2 17.5 6.1 23.7s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L387.7 253.7 410.3 231zM160 399.4l-9.1 22.7c-4 3.1-8.5 5.4-13.3 6.9L59.4 452l23-78.1c1.4-4.9 3.8-9.4 6.9-13.3l22.7-9.1v32c0 8.8 7.2 16 16 16h32zM362.7 18.7L348.3 33.2 325.7 55.8 314.3 67.1l33.9 33.9 62.1 62.1 33.9 33.9 11.3-11.3 22.6-22.6 14.5-14.5c25-25 25-65.5 0-90.5L453.3 18.7c-25-25-65.5-25-90.5 0zm-47.4 168l-144 144c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l144-144c6.2-6.2 16.4-6.2 22.6 0s6.2 16.4 0 22.6z"></path>
            </svg>
        </button>
        <div class="profile-header">
            <div class="profile-pic" id="profilePic">
                <img id="profileImage" src="" alt="Profile Picture">
                <div tabindex="0" class="plusButton" onclick="document.getElementById('directProfilePic').click()">
                    <svg class="plusIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30">
                        <g mask="url(#mask0_21_345)">
                            <path d="M13.75 23.75V16.25H6.25V13.75H13.75V6.25H16.25V13.75H23.75V16.25H16.25V23.75H13.75Z"></path>
                        </g>
                    </svg>
                </div>
                <input type="file" id="directProfilePic" accept="image/*" style="display:none;" onchange="loadImage(event)">
            </div>
            <div class="profile-info">
                <h2>Eswar babu Ettaligalla</h2>
                <p>Email: eswar.e1433@gmail.com</p>
            </div>
        </div>
        <div class="feedback">
            <span>Questions Answered: <span id="questionsAnswered">10</span></span>
            <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-hand-thumbs-up" viewBox="0 0 16 16">
                    <path d="M8.864.046C7.908-.193 7.02.53 6.956 1.466c-.072 1.051-.23 2.016-.428 2.59-.125.36-.479 1.013-1.04 1.639-.557.623-1.282 1.178-2.131 1.41C2.685 7.288 2 7.87 2 8.72v4.001c0 .845.682 1.464 1.448 1.545 1.07.114 1.564.415 2.068.723l.048.03c.272.165.578.348.97.484.397.136.861.217 1.466.217h3.5c.937 0 1.599-.477 1.934-1.064a1.86 1.86 0 0 0 .254-.912c0-.152-.023-.312-.077-.464.201-.263.38-.578.488-.901.11-.33.172-.762.004-1.149.069-.13.12-.269.159-.403.077-.27.113-.568.113-.857 0-.288-.036-.585-.113-.856a2 2 0 0 0-.138-.362 1.9 1.9 0 0 0 .234-1.734c-.206-.592-.682-1.1-1.2-1.272-.847-.282-1.803-.276-2.516-.211a10 10 0 0 0-.443.05 9.4 9.4 0 0 0-.062-4.509A1.38 1.38 0 0 0 9.125.111zM11.5 14.721H8c-.51 0-.863-.069-1.14-.164-.281-.097-.506-.228-.776-.393l-.04-.024c-.555-.339-1.198-.731-2.49-.868-.333-.036-.554-.29-.554-.55V8.72c0-.254.226-.543.62-.65 1.095-.3 1.977-.996 2.614-1.708.635-.71 1.064-1.475 1.238-1.978.243-.7.407-1.768.482-2.85.025-.362.36-.594.667-.518l.262.066c.16.04.258.143.288.255a8.34 8.34 0 0 1-.145 4.725.5.5 0 0 0 .595.644l.003-.001.014-.003.058-.014a9 9 0 0 1 1.036-.157c.663-.06 1.457-.054 2.11.164.175.058.45.3.57.65.107.308.087.67-.266 1.022l-.353.353.353.354c.043.043.105.141.154.315.048.167.075.37.075.581 0 .212-.027.414-.075.582-.05.174-.111.272-.154.315l-.353.353.353.354c.047.047.109.177.005.488a2.2 2.2 0 0 1-.505.805l-.353.353.353.354c.006.005.041.05.041.17a.9.9 0 0 1-.121.416c-.165.288-.503.56-1.066.56z"/>
