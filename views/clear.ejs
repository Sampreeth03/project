<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Interface</title>
    <style>
        :root {
            --primary: #0068FF;
            --dark-bg: #121212;
            --sidebar-bg: #1E1E1E;
            --channel-hover: #2a2a2a;
            --text: #FFFFFF;
            --text-muted: #8e9297;
            --border: #2D2D2D;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar { 
            position: fixed; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 60px; 
            background-color: black; 
            padding: 15px 5%; 
            display: flex; 
            z-index: 1000; 
            align-items: center; 
            justify-content: space-between; 
        }
        .logo { 
            font-size: 30px; 
            color: #0068FF; 
            font-weight: bold; 
            margin-right: 30px; 
        }
        #logo-link { 
            text-decoration: none; 
            color: #0068FF; 
        }
        .nav-links { 
            list-style: none; 
            display: flex; 
            gap: 38px; 
            position: relative; 
        }
        .nav-links li { 
            position: relative; 
        }
        .nav-links li a { 
            color: white; 
            text-decoration: none; 
            font-size: 20px; 
            transition: color 0.3s ease; 
            padding: 10px; 
            display: block; 
        }
        .nav-links li a:hover { 
            color: #0068FF; 
        }
        .dropdown { 
            display: none; 
            position: absolute; 
            top: 100%; 
            left: 0; 
            background-color: black; 
            min-width: max-content; 
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2); 
            z-index: 1000; 
        }
        .dropdown li { 
            width: 100%; 
        }
        .dropdown li a { 
            padding: 12px; 
            font-size: 18px; 
            display: block; 
            color: white; 
            white-space: nowrap; 
        }
        .dropdown li a:hover { 
            background-color: #333; 
            color: #0068FF; 
        }
        .nav-links li:hover .dropdown { 
            display: block; 
        }
        .search-box { 
            padding: 8px; 
            border-radius: 5px; 
            border: none; 
            outline: none; 
            width: 205px; 
            background-color: #222; 
            color: white; 
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 56px);
        }

        .chat-header {
            margin-top: 100px;
            height: 60px;
            padding: 0 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
        }

        .messages-container {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
        }

        .message {
            display: flex;
            margin-bottom: 16px;
        }

        .message.reply {
            margin-left: 40px;
            opacity: 0.8;
        }

        .message-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary);
            margin-right: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .message-content {
            flex: 1;
        }

        .message-header {
            display: flex;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .message-author {
            font-weight: bold;
            margin-right: 8px;
        }

        .message-time {
            font-size: 12px;
            color: var(--text-muted);
        }

        .message-text {
            line-height: 1.4;
        }

        button.reply-btn {
            font-size: 14px;
            color: #e1e1e1;
            font-family: inherit;
            font-weight: 800;
            cursor: pointer;
            position: relative;
            border: 2px solid #0068FF;
            background-color: #0068FF;
            text-transform: uppercase;
            transition-timing-function: cubic-bezier(0.25, 0.8, 0.25, 1);
            transition-duration: 400ms;
            transition-property: color, background-color;
            padding: 6px 14px;
            border-radius: 5px;
            margin-top: 8px;
        }

        button.reply-btn:focus,
        button.reply-btn:hover {
            color: #fff;
            background-color: #0051CC;
        }

        button.reply-btn:focus:after,
        button.reply-btn:hover:after {
            width: 100%;
            left: 0%;
        }

        button.reply-btn:after {
            content: "";
            pointer-events: none;
            bottom: -2px;
            left: 50%;
            position: absolute;
            width: 0%;
            height: 2px;
            background-color: #fff;
            transition-timing-function: cubic-bezier(0.25, 0.8, 0.25, 1);
            transition-duration: 400ms;
            transition-property: width, left;
        }

        .reply-container {
            display: flex;
            align-items: center;
            margin-top: 8px;
        }

        .reply-text {
            margin-left: 10px;
            color: var(--text-muted);
        }

        .messageBox {
            width: fit-content;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #1e1e1e;
            padding: 0 15px;
            border-radius: 10px;
            border: 1px solid rgb(63, 63, 63);
            margin-top: 8px;
            width: 100%;
        }

        .messageBox:focus-within {
            border: 1px solid #606060;
        }

        .fileUploadWrapper {
            width: fit-content;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif;
        }

        .fileInput {
            display: none;
        }

        .fileUploadWrapper label {
            cursor: pointer;
            width: fit-content;
            height: fit-content;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .fileUploadWrapper label svg {
            height: 18px;
        }

        .fileUploadWrapper label svg path {
            transition: all 0.3s;
        }

        .fileUploadWrapper label svg circle {
            transition: all 0.3s;
        }

        .fileUploadWrapper label:hover svg path {
            stroke: #fff;
        }

        .fileUploadWrapper label:hover svg circle {
            stroke: #fff;
            fill: #3c3c3c;
        }

        .fileUploadWrapper label:hover .tooltip {
            display: block;
            opacity: 1;
        }

        .tooltip {
            position: absolute;
            top: -40px;
            display: none;
            opacity: 0;
            color: white;
            font-size: 10px;
            text-wrap: nowrap;
            background-color: #000;
            padding: 6px 10px;
            border: 1px solid #3c3c3c;
            border-radius: 5px;
            box-shadow: 0px 5px 10px rgba(0, 0, 0, 0.596);
            transition: all 0.3s;
        }

        .messageInput {
            width: 200px;
            height: 100%;
            background-color: transparent;
            outline: none;
            border: none;
            padding-left: 10px;
            color: #f5f5f5;
            flex-grow: 1;
        }

        .messageInput:focus ~ .sendButton svg path,
        .messageInput:valid ~ .sendButton svg path {
            fill: #3c3c3c;
            stroke: white;
        }

        .sendButton {
            width: fit-content;
            height: 100%;
            background-color: transparent;
            outline: none;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .sendButton svg {
            height: 18px;
            transition: all 0.3s;
        }

        .sendButton svg path {
            transition: all 0.3s;
        }

        .sendButton:hover svg path {
            fill: #3682f4;
            stroke: white;
        }

        .no-doubts {
            text-align: center;
            color: var(--text-muted);
            margin-top: 20px;
            font-size: 16px;
        }
    </style>
</head>
<body>
    
        <header>
            <header>
                <div class="navbar">
                    <span class="logo"><a id="logo-link" href="<%= homeUrl %>">RELABTeams</a></span>
                    <ul class="nav-links">
                        <% navLinks.forEach(link => { %>
                            <li>
                                <a href="<%= link.href %>"><%= link.name %></a>
                                <% if (link.submenu) { %>
                                    <ul class="dropdown">
                                        <% link.submenu.forEach(sublink => { %>
                                            <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                                        <% }) %>
                                    </ul>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>
                    <input type="text" placeholder="Search" class="search-box">
                </div>
            </header>
            <div class="chat-area">
                <div class="chat-header">
                    <h2>Clear Doubts</h2>
                </div>
                <div class="messages-container" id="chat-container">
                    <% if (doubts && doubts.length > 0) { %>
                        <% doubts.forEach((doubt, index) => { %>
                            <div class="message" id="doubt-<%= doubt._id %>">
                                <div class="message-avatar"><%= (doubt.author || "Anonymous").charAt(0) %></div>
                                <div class="message-content">
                                    <div class="message-header">
                                        <span class="message-author"><%= doubt.author || "Anonymous" %></span>
                                        <span class="message-time"><%= new Date(doubt.timestamp).toLocaleTimeString() %></span>
                                    </div>
                                    <div class="message-text"><%= doubt.text %></div>
                                    <% if (doubt.file_path) { %>
                                        <div class="image-container">
                                            <a href="/<%= doubt.file_path %>" target="_blank">View File</a>
                                        </div>
                                    <% } %>
                                    <div id="reply-container-<%= doubt._id %>">
                                        <% if (doubt.replies && doubt.replies.length > 0) { %>
                                            <% doubt.replies.forEach(reply => { %>
                                                <div class="message reply">
                                                    <div class="message-avatar"><%= (reply.author || "Anonymous").charAt(0) %></div>
                                                    <div class="message-content">
                                                        <div class="message-header">
                                                            <span class="message-author"><%= reply.author || "Anonymous" %></span>
                                                            <span class="message-time"><%= new Date(reply.timestamp).toLocaleTimeString() %></span>
                                                        </div>
                                                        <div class="message-text"><%= reply.text %></div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                                                        <% 
                                                                            const isOwner = doubt.user_id && doubt.user_id._id && doubt.user_id._id.toString() === user.id;
                                                                            let otherReplyExists = false;
                                                                            if (isOwner && doubt.replies && doubt.replies.length > 0) {
                                                                                otherReplyExists = doubt.replies.some(r => r.user_id && r.user_id._id && r.user_id._id.toString() !== doubt.user_id._id.toString());
                                                                            }
                                                                            const canShowReplyButton = user.role === 'user' && (!isOwner || otherReplyExists);
                                                                        %>
                                                                        <% if (canShowReplyButton) { %>
                                                                            <button class="reply-btn" onclick="showReplyBox('<%= doubt._id %>')" id="reply-btn-<%= doubt._id %>">Reply</button>
                                                                            <div id="reply-input-container-<%= doubt._id %>" style="display:none;">
                                                                                    <div class="messageBox">
                                                                                            <input class="messageInput" id="messageInput-<%= doubt._id %>" type="text" placeholder="Your reply..." required onkeypress="handleReply(event, '<%= doubt._id %>')" />
                                                                                            <button class="sendButton" onclick="sendReply('<%= doubt._id %>')">
                                                                                                    <svg viewBox="0 0 664 663" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                                                            <path d="M646.293 331.888L17.7538 17.6187L155.245 331.888M646.293 331.888L17.753 646.157L155.245 331.888M646.293 331.888L318.735 330.228L155.245 331.888" stroke="#6c6c6c" stroke-width="33.67" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                                                    </svg>
                                                                                            </button>
                                                                                    </div>
                                                                            </div>
                                                                        <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="no-doubts">No doubts found. Be the first to ask a question!</div>
                    <% } %>
                </div>
            </div>
            <script>
                function showReplyBox(doubtId) {
                    const inputContainer = document.getElementById(`reply-input-container-${doubtId}`);
                    inputContainer.style.display = "block";
                    document.getElementById(`messageInput-${doubtId}`).focus();
                }
        
                function handleReply(event, doubtId) {
                    if (event.key === "Enter") {
                        sendReply(doubtId);
                    }
                }
        
                function sendReply(doubtId) {
    const inputBox = document.getElementById(`messageInput-${doubtId}`);
    const replyText = inputBox.value.trim();

    if (replyText) {
        fetch('/reply', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ doubtId, text: replyText })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const replyContainer = document.getElementById(`reply-container-${doubtId}`);
                const replyDiv = document.createElement("div");
                replyDiv.classList.add("message", "reply");
                replyDiv.innerHTML = `
                    <div class="message-avatar">${data.reply.author.charAt(0)}</div>
                    <div class="message-content">
                        <div class="message-header">
                            <span class="message-author">${data.reply.author}</span>
                            <span class="message-time">${new Date(data.reply.timestamp).toLocaleTimeString()}</span>
                        </div>
                        <div class="message-text">${data.reply.text}</div>
                    </div>
                `;
                replyContainer.appendChild(replyDiv);
                inputBox.value = "";
                document.getElementById(`reply-input-container-${doubtId}`).style.display = "none";
                document.getElementById(`reply-btn-${doubtId}`).style.display = "none";
            } else {
                alert("Failed to send reply: " + (data.message || "Unknown error"));
            }
        })
        .catch(error => {
            console.error("Error sending reply:", error);
            alert("An error occurred while sending the reply");
        });
    }
}
            </script>
    </body>
</html>