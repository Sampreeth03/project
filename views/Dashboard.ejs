<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RELABTeams Dashboard</title>
  <style>
    :root {
      --bg-primary: #121212;
      --bg-secondary: #1e1e1e;
      --text-primary: #ffffff;
      --text-secondary: #b3b3b3;
      --accent-color: #0068FF;
      --card-bg: #252525;
      --border-color: #333333;
      --gradient-start: #0068FF;
      --gradient-end: #00a1ff;
      --hover-color: #2b80ff;
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    body {
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      padding-top: 60px;
    }
    .navbar { 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 100%; 
      height: 60px; 
      background-color: black; 
      padding: 15px 5%; 
      display: flex; 
      z-index: 1000; 
      align-items: center; 
      justify-content: space-between; 
    }
    .logo { 
      font-size: 30px; 
      color: var(--accent-color); 
      font-weight: bold; 
      margin-right: 30px; 
    }
    #logo-link { 
      text-decoration: none; 
      color: var(--accent-color); 
    }
    .nav-links { 
      list-style: none; 
      display: flex; 
      gap: 38px; 
      position: relative; 
    }
    .nav-links li { 
      position: relative; 
    }
    .nav-links li a { 
      color: white; 
      text-decoration: none; 
      font-size: 20px; 
      transition: color 0.3s ease; 
      padding: 10px; 
      display: block; 
    }
    .nav-links li a:hover { 
      color: var(--accent-color); 
    }
    .dropdown { 
      display: none; 
      position: absolute; 
      top: 100%; 
      left: 0; 
      background-color: black; 
      min-width: max-content; 
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2); 
      z-index: 1000; 
    }
    .dropdown li { 
      width: 100%; 
    }
    .dropdown li a { 
      padding: 12px; 
      font-size: 18px; 
      display: block; 
      color: white; 
      white-space: nowrap; 
    }
    .dropdown li a:hover { 
      background-color: #333; 
      color: var(--accent-color); 
    }
    .nav-links li:hover .dropdown { 
      display: block; 
    }
    .search-box { 
      padding: 8px; 
      border-radius: 5px; 
      border: none; 
      outline: none; 
      width: 205px; 
      background-color: #222; 
      color: white; 
    }
    .main-content {
      padding: 30px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .dashboard-header {
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .user-greeting {
      flex: 1;
    }
    .dashboard-title {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 10px;
      background: linear-gradient(to right, var(--accent-color), var(--gradient-end));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 15px;
      background-color: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .profile-image {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: var(--accent-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: bold;
      color: white;
    }
    .profile-info {
      display: flex;
      flex-direction: column;
    }
    .profile-name {
      font-weight: 600;
      font-size: 16px;
    }
    .profile-role {
      font-size: 12px;
      color: var(--text-secondary);
    }
    .metrics-container {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    .metric-card {
      background-color: var(--card-bg);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .metric-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }
    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 6px;
      height: 100%;
      background: linear-gradient(to bottom, var(--gradient-start), var(--gradient-end));
    }
    .metric-title {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 10px;
      font-weight: 500;
    }
    .metric-value {
      font-size: 32px;
      font-weight: 700;
      color: var(--text-primary);
    }
    .completed-projects {
      background-color: var(--card-bg);
      border-radius: 12px;
      padding: 20px;
      text-rendering: geometricPrecision;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    .completed-projects-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .completed-projects-title {
      font-size: 18px;
      font-weight: 600;
    }
    .view-all {
      font-size: 12px;
      color: var(--accent-color);
      text-decoration: none;
      transition: color 0.3s ease;
    }
    .view-all:hover {
      color: var(--hover-color);
      text-decoration: underline;
    }
    .project-list {
      list-style: none;
    }
    .project-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      border-bottom: 1px solid var(--border-color);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .project-item:hover {
      background-color: rgba(255, 255, 255, 0.05);
      transform: translateX(5px);
      padding-left: 20px;
    }
    .project-item:hover::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background-color: var(--accent-color);
    }
    .project-item:last-child {
      border-bottom: none;
    }
    .project-info {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .project-name {
      font-weight: 500;
    }
    .project-date {
      font-size: 11px;
      color: var(--text-secondary);
    }
    .project-status {
      font-size: 12px;
      padding: 4px 10px;
      border-radius: 20px;
      background-color: var(--accent-color);
      color: white;
      font-weight: 500;
    }
    .project-status.completed {
      background-color: #4caf50;
    }
    .footer {
      padding: 20px 30px;
      font-size: 12px;
      color: var(--text-secondary);
      text-align: center;
      margin-top: 30px;
      border-top: 1px solid var(--border-color);
    }
    @media (max-width: 1200px) {
      .metrics-container {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (max-width: 900px) {
      .metrics-container {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .metrics-container {
        grid-template-columns: 1fr;
      }
      .dashboard-header {
        flex-direction: column;
        gap: 20px;
      }
      .user-profile {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="navbar">
      <span class="logo"><a id="logo-link" href="<%= homeUrl %>">RELABTeams</a></span>
      <ul class="nav-links">
        <% navLinks.forEach(link => { %>
          <li>
            <a href="<%= link.href %>">
              <%= link.name %>
              <% if (link.name === 'Notifications' && typeof unreadNotifCount !== 'undefined' && unreadNotifCount > 0) { %>
                <span class="notif-badge show" id="notif-badge"><%= unreadNotifCount %></span>
              <% } %>
            </a>
            <% if (link.submenu) { %>
              <ul class="dropdown">
                <% link.submenu.forEach(sublink => { %>
                  <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                <% }) %>
              </ul>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <input type="text" placeholder="Search" class="search-box">
    </div>
  </header>
  <div class="main-content">
    <div class="dashboard-header">
      <div class="user-greeting">
        <h1 class="dashboard-title">Dashboard</h1>
        <p>Welcome back, <%= userData.username %>. Here's your current performance summary.</p>
      </div>
      <div class="user-profile">
        <div class="profile-image">
          <%= userData.username.charAt(0) %>
        </div>
        <div class="profile-info">
          <div class="profile-name"><%= userData.username %></div>
          <div class="profile-role">Student │ IIIT Sri City</div>
        </div>
      </div>
    </div>
    <div class="metrics-container">
      <div class="metric-card">
        <div class="metric-title">Total Collaborations</div>
        <div class="metric-value"><%= userData.metrics.total_collaborations || 0 %></div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Active Projects</div>
        <div class="metric-value"><%= userData.metrics.active_projects || 0 %></div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Completed Tasks</div>
        <div class="metric-value"><%= userData.metrics.completed_tasks || 0 %></div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Leadership Roles</div>
        <div class="metric-value"><%= userData.metrics.leadership_roles || 0 %></div>
      </div>
      
      <div class="metric-card">
        <div class="metric-title">Inquiries Initiated</div>
        <div class="metric-value"><%= userData.metrics.inquiriesInitiated || 0 %></div>
    </div>
      
      <div class="metric-card">
        <div class="metric-title">Job Applications</div>
        <div class="metric-value"><%= userData.metrics.job_applications || 0 %></div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Projects as Member</div>
        <div class="metric-value"><%= userData.metrics.projects_as_member || 0 %></div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Solutions Provided</div>
        <div class="metric-value"><%= userData.metrics.solutions_provided || 0 %></div>
    </div>
      
    
    <% if (completedProjects && completedProjects.length > 0) { %>
      <div class="completed-projects">
        <div class="completed-projects-header">
          <h2 class="completed-projects-title">Completed Projects</h2>
          <a href="/project" class="view-all">View All Projects</a>
        </div>
        <ul class="project-list">
          <% completedProjects.forEach(project => { %>
            <li class="project-item">
              <div class="project-info">
                <div class="project-name"><%= project.title %></div>
                <div class="project-date">Completed on <%= new Date(project.deadline).toLocaleDateString() %></div>
              </div>
              <div class="project-status completed">Completed</div>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } else { %>
      <div class="completed-projects">
        <div class="completed-projects-header">
          <h2 class="completed-projects-title">No Completed Projects Yet</h2>
          <a href="/project" class="view-all">Start a Project</a>
        </div>
      </div>
    <% } %>
  </div>
 
</body>
</html>