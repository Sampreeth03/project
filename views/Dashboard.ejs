<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RELABTeams Dashboard</title>
  <style>
    :root {
      --bg-primary: #121212;
      --bg-secondary: #1e1e1e;
      --text-primary: #ffffff;
      --text-secondary: #b3b3b3;
      --accent-color: #0068FF;
      --card-bg: #252525;
      --border-color: #333333;
      --gradient-start: #0068FF;
      --gradient-end: #00a1ff;
      --hover-color: #2b80ff;
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    body {
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      padding-top: 60px;
    }
    .navbar { 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 100%; 
      height: 60px; 
      background-color: black; 
      padding: 15px 5%; 
      display: flex; 
      z-index: 1000; 
      align-items: center; 
      justify-content: space-between; 
    }
    .logo { 
      font-size: 30px; 
      color: var(--accent-color); 
      font-weight: bold; 
      margin-right: 30px; 
    }
    #logo-link { 
      text-decoration: none; 
      color: var(--accent-color); 
    }
    .nav-links { 
      list-style: none; 
      display: flex; 
      gap: 38px; 
      position: relative; 
    }
    .nav-links li { 
      position: relative; 
    }
    .nav-links li a { 
      color: white; 
      text-decoration: none; 
      font-size: 20px; 
      transition: color 0.3s ease; 
      padding: 10px; 
      display: block; 
    }
    .nav-links li a:hover { 
      color: var(--accent-color); 
    }
    .dropdown { 
      display: none; 
      position: absolute; 
      top: 100%; 
      left: 0; 
      background-color: black; 
      min-width: max-content; 
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2); 
      z-index: 1000; 
    }
    .dropdown li a:hover { 
      background-color: #333; 
      color: var(--accent-color); 
    }
    .nav-links li:hover .dropdown { 
      display: block; 
    }
    .search-box { 
      padding: 8px; 
      border-radius: 5px; 
      border: none; 
      outline: none; 
      width: 205px; 
      background-color: #222; 
      color: white; 
    }
    .main-content {
      padding: 30px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .dashboard-header {
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .user-greeting {
      flex: 1;
    }
    .dashboard-title {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 10px;
      background: linear-gradient(to right, var(--accent-color), var(--gradient-end));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 15px;
      background-color: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .profile-image {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: var(--accent-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: bold;
      color: white;
    }
    .metrics-container {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    .metric-card {
      background-color: var(--card-bg);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .metric-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }
    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 6px;
      height: 100%;
      background: linear-gradient(to bottom, var(--gradient-start), var(--gradient-end));
    }
    .metric-title {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 10px;
    }
    .metric-value {
      font-size: 32px;
      font-weight: 700;
    }
    .completed-projects {
      background-color: var(--card-bg);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    .completed-projects-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .completed-projects-title {
      font-size: 18px;
      font-weight: 600;
    }
    .view-all {
      font-size: 12px;
      color: var(--accent-color);
      text-decoration: none;
    }
    .view-all:hover {
      color: var(--hover-color);
      text-decoration: underline;
    }
    .project-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      border-bottom: 1px solid var(--border-color);
    }
    .project-status.completed {
      background-color: #4caf50;
      color: white;
      border-radius: 20px;
      padding: 5px 10px;
      font-size: 12px;
    }
    @media (max-width: 900px) {
      .metrics-container {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .metrics-container {
        grid-template-columns: 1fr;
      }
      .dashboard-header {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="navbar">
      <span class="logo"><a id="logo-link" href="<%= homeUrl %>">RELABTeams</a></span>
      <ul class="nav-links">
        <% navLinks.forEach(link => { %>
          <li>
            <a href="<%= link.href %>"><%= link.name %></a>
            <% if (link.submenu) { %>
              <ul class="dropdown">
                <% link.submenu.forEach(sublink => { %>
                  <li><a href="<%= sublink.href %>"><%= sublink.name %></a></li>
                <% }) %>
              </ul>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <input type="text" placeholder="Search metrics..." class="search-box">
    </div>
  </header>

  <div class="main-content">
    <div class="dashboard-header">
      <div class="user-greeting">
        <h1 class="dashboard-title">Dashboard</h1>
        <p id="user-welcome">Loading your data...</p>
      </div>
      <div class="user-profile" id="user-profile">
        <div class="profile-image">?</div>
        <div class="profile-info">
          <div class="profile-name">Loading...</div>
          <div class="profile-role">Student │ IIIT Sri City</div>
        </div>
      </div>
    </div>

    <div class="metrics-container" id="metrics-container">
      <p>Loading metrics...</p>
    </div>
    <div id="completed-projects-container">
      <p>Loading completed projects...</p>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      setTimeout(() => {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", "/api/dashboard-metrics", true);

        xhr.onload = function() {
          if (xhr.status === 200) {
            const data = JSON.parse(xhr.responseText);

            // Update profile info
            document.querySelector('.profile-name').textContent = data.username;
            document.querySelector('.profile-image').textContent = data.username.charAt(0).toUpperCase();
            document.getElementById('user-welcome').textContent =
              `Welcome back, ${data.username}. Here's your current performance summary.`;

            // Metrics
            const m = data.metrics;
            const metricsHTML = `
              <div class="metric-card"><div class="metric-title">Total Collaborations</div><div class="metric-value">${m.total_collaborations || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Active Projects</div><div class="metric-value">${m.active_projects || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Completed Tasks</div><div class="metric-value">${m.completed_tasks || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Leadership Roles</div><div class="metric-value">${m.leadership_roles || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Inquiries Initiated</div><div class="metric-value">${m.inquiriesInitiated || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Job Applications</div><div class="metric-value">${m.job_applications || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Projects as Member</div><div class="metric-value">${m.projects_as_member || 0}</div></div>
              <div class="metric-card"><div class="metric-title">Solutions Provided</div><div class="metric-value">${m.solutions_provided || 0}</div></div>
            `;
            document.getElementById("metrics-container").innerHTML = metricsHTML;

            // Completed Projects
            const projectsHTML = data.completedProjects.length > 0
              ? `
                <div class="completed-projects">
                  <div class="completed-projects-header">
                    <h2 class="completed-projects-title">Completed Projects</h2>
                    <a href="/project" class="view-all">View All Projects</a>
                  </div>
                  <ul class="project-list">
                    ${data.completedProjects.map(p => `
                      <li class="project-item">
                        <div class="project-info">
                          <div class="project-name">${p.title}</div>
                          <div class="project-date">Completed on ${new Date(p.deadline).toLocaleDateString()}</div>
                        </div>
                        <div class="project-status completed">Completed</div>
                      </li>
                    `).join('')}
                  </ul>
                </div>
              `
              : `
                <div class="completed-projects">
                  <div class="completed-projects-header">
                    <h2 class="completed-projects-title">No Completed Projects Yet</h2>
                    <a href="/project" class="view-all">Start a Project</a>
                  </div>
                </div>
              `;
            document.getElementById("completed-projects-container").innerHTML = projectsHTML;

            // ✅ SEARCH FUNCTIONALITY
            const search = document.querySelector(".search-box");
            search.addEventListener("input", () => {
              const term = search.value.toLowerCase();
              const cards = document.querySelectorAll(".metric-card");
              cards.forEach(card => {
                const title = card.querySelector(".metric-title").textContent.toLowerCase();
                if (title.includes(term)) {
                  card.style.display = "block";
                } else {
                  card.style.display = "none";
                }
              });
            });

          } else {
            document.getElementById('metrics-container').innerHTML = `<p>Failed to load metrics.</p>`;
          }
        };

        xhr.onerror = function() {
          document.getElementById('metrics-container').innerHTML = `<p>Network error. Try again later.</p>`;
        };

        xhr.send();
      }, 1500); // 1.5s delay for simulated async loading
    });
  </script>
</body>
</html>
