<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RELABTeams Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #0068FF;
            --secondary: #0056d6;
            --dark: #121212;
            --darker: #0a0a0a;
            --light-text: #ffffff;
            --gray-text: #a0a0a0;
            --gray-dark: #2a2a2a;
            --success: #4ade80;
            --danger: #ef4444;
            --warning: #f59e0b;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: var(--dark);
            color: var(--light-text);
        }
        .container {
            display: flex;
            min-height: 100vh;
        }
        .sidebar {
            width: 280px;
            background-color: var(--darker);
            color: var(--light-text);
            padding: 20px 0;
            height: 100vh;
            position: fixed;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 100;
        }
        .sidebar-header {
            padding: 0 25px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }
        .logo-text {
            font-size: 22px;
            font-weight: 700;
            color: #0068FF;
        }
        .nav-menu {
            padding: 10px 0;
        }
        .menu-label {
            padding: 0 25px;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--gray-text);
            margin-bottom: 10px;
            margin-top: 20px;
        }
        .menu-item {
            padding: 12px 25px;
            display: flex;
            align-items: center;
            color: var(--gray-text);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }
        .menu-item:hover {
            color: var(--light-text);
            background-color: rgba(255, 255, 255, 0.05);
        }
        .menu-item.active {
            color: var(--light-text);
            background-color: rgba(0, 104, 255, 0.1);
            border-left: 4px solid var(--primary);
        }
        .menu-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            font-size: 18px;
        }
        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 30px;
            transition: all 0.3s;
            overflow-x: hidden;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .welcome h2 {
            font-weight: 600;
            margin-bottom: 5px;
        }
        .welcome h4 {
            color: var(--gray-text);
            font-weight: normal;
        }
        .admin-controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        .search-box {
            position: relative;
            width: 300px;
        }
        .search-box input {
            width: 100%;
            padding: 10px 40px 10px 15px;
            border-radius: 8px;
            border: 1px solid var(--gray-dark);
            background-color: var(--darker);
            color: var(--light-text);
            outline: none;
        }
        .search-box input::placeholder {
            color: var(--gray-text);
        }
        .search-box i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-text);
        }
        .admin-profile {
            display: flex;
            align-items: center;
            cursor: pointer;
        }
        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }
        .admin-info {
            display: flex;
            flex-direction: column;
        }
        .admin-name {
            font-weight: 500;
        }
        .admin-role {
            font-size: 12px;
            color: var(--gray-text);
        }
        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .card {
            background-color: var(--darker);
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .card-title {
            font-size: 18px;
            font-weight: 500;
        }
        .card-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
        .bg-primary { background-color: var(--primary); }
        .bg-success { background-color: var(--success); }
        .bg-danger { background-color: var(--danger); }
        .bg-warning { background-color: var(--warning); }
        .card-body {
            flex: 1;
        }
        .stat {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .stat-desc {
            color: var(--gray-text);
            font-size: 14px;
            display: flex;
            align-items: center;
        }
        .stat-up {
            color: var(--success);
            margin-right: 5px;
        }
        .stat-down {
            color: var(--danger);
            margin-right: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <%- include('partials/sidebar', { activePage: activePage }) %>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <div class="header">
                <div class="welcome">
                    <h2>Welcome, <%= dashboardData.adminName %>!</h2>
                    <h4>Here's what's happening on RELABTeams today</h4>
                </div>
                <div class="admin-controls">
                    <div class="search-box">
                        <input id="admin-search" type="text" placeholder="Search..." autocomplete="off">
                        <i class="fas fa-search"></i>
                    </div>
                    <div class="admin-profile">
                        <div class="admin-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="admin-info">
                            <div class="admin-name"><%= dashboardData.adminName %></div>
                            <div class="admin-role"><%= dashboardData.adminRole %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Cards Container (client-rendered) -->
            <div class="dashboard-cards" id="dashboardCardsContainer" data-cards="<%= encodeURIComponent(JSON.stringify(dashboardData.dashboardCards || [])) %>">
                <!-- Cards will be rendered by client JS -->
            </div>

            <script>
                (function(){
                    const container = document.getElementById('dashboardCardsContainer');
                    const raw = container ? container.getAttribute('data-cards') : '[]';
                    let dashboardCards = [];
                    try { dashboardCards = JSON.parse(decodeURIComponent(raw || '[]')); } catch (e) { dashboardCards = []; }
                    const periodText = '<%= dashboardData.period %>' || 'period';

                    function escapeHtml(str){
                        if (str === undefined || str === null) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#39;');
                    }

                    function renderChangeSpan(change){
                        const num = Number(change) || 0;
                        if (num > 0) return `<span class="stat-up"><i class="fas fa-arrow-up"></i>${Math.abs(num)}%</span>`;
                        if (num < 0) return `<span class="stat-down"><i class="fas fa-arrow-down"></i>${Math.abs(num)}%</span>`;
                        return `<span style="color:var(--gray-text)">0%</span>`;
                    }

                    function createCard(card, i){
                        const el = document.createElement('div');
                        el.className = 'card';
                        el.setAttribute('role','article');
                        el.setAttribute('tabindex','0');
                        el.setAttribute('aria-label', `${card.title}: ${card.stat} since last ${periodText}`);
                        // data attributes used for client-side search/filter
                        el.dataset.title = (card.title || '').toLowerCase();
                        el.dataset.type = (card.type || '').toLowerCase();
                        el.dataset.tags = (card.tags && Array.isArray(card.tags)) ? card.tags.join(',').toLowerCase() : '';
                        el.style.opacity = '0';
                        el.style.transform = 'translateY(12px)';
                        el.innerHTML = `
                            <div class="card-header">
                                <div class="card-title">${escapeHtml(card.title)}</div>
                                <div class="card-icon bg-${escapeHtml(card.colorClass || 'primary')}">
                                    <i class="fas fa-${escapeHtml(card.icon || 'chart-line')}"></i>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="stat">${escapeHtml(card.stat)}</div>
                                <div class="stat-desc">
                                    ${renderChangeSpan(card.change)}
                                    since last ${escapeHtml(periodText)}
                                </div>
                            </div>
                        `;

                        setTimeout(() => {
                            el.style.transition = 'all 350ms';
                            el.style.opacity = '1';
                            el.style.transform = 'translateY(0)';
                        }, 80 * i);

                        return el;
                    }

                    if (Array.isArray(dashboardCards) && dashboardCards.length){
                        dashboardCards.forEach((c, idx) => container.appendChild(createCard(c, idx)));
                    } else {
                        container.innerHTML = '<div class="card"><div class="card-body">No dashboard data available.</div></div>';
                    }
                })();
            </script>
        </div>
    </div>
    <script>
        (function(){
            const input = document.getElementById('admin-search');
            const container = document.getElementById('dashboardCardsContainer');
            const cardsSelector = '.card';

            function normalize(s){ return (s||'').toLowerCase(); }

            function filterCards(query){
                const q = normalize(query);
                const cards = container.querySelectorAll(cardsSelector);
                let visibleCount = 0;
                cards.forEach(card => {
                    if (!q) {
                        card.style.display = '';
                        visibleCount++;
                        return;
                    }
                    const title = card.dataset.title || '';
                    const type = card.dataset.type || '';
                    const tags = card.dataset.tags || '';
                    const matches = title.includes(q) || type.includes(q) || tags.includes(q);
                    card.style.display = matches ? '' : 'none';
                    if (matches) visibleCount++;
                });
                // Optionally, announce or show a small message if no results
                // (could add ARIA live announcements here)
            }

            input.addEventListener('input', function(){
                const q = this.value.trim();
                filterCards(q);
            });

            // initialize: show all
            filterCards('');
        })();
    </script>
</body>
</html>